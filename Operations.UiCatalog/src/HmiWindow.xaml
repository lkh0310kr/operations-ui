<Window x:Class="Operations.UiCatalog.HmiWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="clr-namespace:Operations.UI.Controls;assembly=Operations.UI"
 Title="HMI 설비 운전 · 샘플" Width="1280" Height="800" MinWidth="960" MinHeight="680"
 Background="{DynamicResource Ops.Brush.Surface.Canvas}" Foreground="{DynamicResource Ops.Brush.Text.Primary}"
 FontFamily="{DynamicResource FontFamilyBody}" UseLayoutRounding="True">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
  <ResourceDictionary Source="pack://application:,,,/Operations.UI;component/src/Themes/Foundation/Density.Touch.xaml"/>
 </ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="HMI / 설비 운전" Style="{StaticResource SupportingText}"/><TextBlock Text="혼합기 MX-04" Style="{StaticResource PageTitle}" Margin="0,8,0,0"/><TextBlock Text="샘플 데이터 · 장치에 연결되지 않음" Style="{StaticResource SupportingText}" Margin="0,4,0,0"/></StackPanel>
   <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="운전 모드" Style="{StaticResource SupportingText}"/><TextBlock Text="자동 · 마지막 확인값" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
  </Grid>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="450"/><ColumnDefinition Width="16"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="{DynamicResource Ops.Brush.Surface.Panel}" BorderBrush="{DynamicResource Ops.Brush.Border.Subtle}" BorderThickness="1" Padding="16" CornerRadius="{DynamicResource Ops.Radius.Panel}">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="마지막 확인 운전 상태" Style="{StaticResource SupportingText}"/><ui:StatusIndicator Content="운전 중" Margin="0,8,0,0"/></StackPanel>
      <StackPanel Grid.Column="1"><TextBlock Text="연결" Style="{StaticResource SupportingText}"/><ui:StatusIndicator Content="끊김" Tone="Warning" Margin="0,8,0,0"/></StackPanel>
      <StackPanel Grid.Column="2"><TextBlock Text="데이터 최신성" Style="{StaticResource SupportingText}"/><ui:StatusIndicator Content="오래됨" Tone="Warning" Margin="0,8,0,0"/></StackPanel>
     </Grid>
    </Border>
    <Grid Grid.Row="1" Margin="0,20,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="혼합 온도" Style="{StaticResource SupportingText}"/><StackPanel Orientation="Horizontal"><TextBlock Text="73.4" FontSize="{DynamicResource FontMetricValue}" FontWeight="Medium"/><TextBlock Text="°C" VerticalAlignment="Bottom" Margin="8,0,0,4"/></StackPanel><TextBlock Text="정상 범위 65.0–80.0 °C" Style="{StaticResource SupportingText}"/><TextBlock Text="품질: 양호 · 마지막 수신 10:24:00" Style="{StaticResource SupportingText}" Margin="0,4,0,0"/></StackPanel>
     <StackPanel Grid.Column="1"><TextBlock Text="교반 속도" Style="{StaticResource SupportingText}"/><StackPanel Orientation="Horizontal"><TextBlock Text="—" FontSize="{DynamicResource FontMetricValue}" FontWeight="Medium"/><TextBlock Text="rpm" VerticalAlignment="Bottom" Margin="8,0,0,4"/></StackPanel><TextBlock Text="정상 범위 800–1,200 rpm" Style="{StaticResource SupportingText}"/><TextBlock Text="품질: 신뢰할 수 없음 · 값 없음" Style="{StaticResource SupportingText}" Margin="0,4,0,0"/></StackPanel>
    </Grid>
    <Grid Grid.Row="2" MinHeight="150"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="혼합 온도 추세 · °C" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
     <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid><TextBlock Text="90" VerticalAlignment="Top" Style="{StaticResource SupportingText}"/><TextBlock Text="50" VerticalAlignment="Bottom" Style="{StaticResource SupportingText}"/></Grid>
      <ui:Trend x:Name="TemperatureTrend" Grid.Column="1" Samples="{Binding Samples}" Start="{Binding Start}" End="{Binding End}" Minimum="50" Maximum="90" AutomationProperties.Name="샘플 혼합 온도 추세, 10시 14분부터 10시 24분, 섭씨 50도에서 90도" AutomationProperties.HelpText="68.1도에서 73.4도로 상승. 10시 19분 샘플은 값이 없어 선을 끊었습니다."/>
     </Grid>
     <Grid Grid.Row="2" Margin="36,8,0,0"><TextBlock Text="10:14" Style="{StaticResource SupportingText}"/><TextBlock Text="10:24" HorizontalAlignment="Right" Style="{StaticResource SupportingText}"/></Grid>
    </Grid>
    <TextBlock Grid.Row="3" Text="추세는 샘플이며, 품질이 불확실하거나 값이 없는 구간은 연결하지 않습니다." Style="{StaticResource SupportingText}" TextWrapping="Wrap" Margin="0,12,0,0"/>
   </Grid>
   <ui:Inspector Grid.Column="2" Header="알람 및 명령" AutomationProperties.Name="알람 및 명령 상세">
    <StackPanel><TextBlock Text="활성 알람 · 1" FontWeight="SemiBold"/><ui:StatusIndicator Content="온도 편차 확인 필요" Tone="Warning" Margin="0,12,0,0"/><TextBlock Text="AL-0042 · 10:20:00" Style="{StaticResource SupportingText}" Margin="14,4,0,0"/><TextBlock Text="{Binding AlarmActiveDescription}" Margin="14,8,0,0"/><TextBlock Text="{Binding Acknowledgement}" Margin="14,4,0,0"/><ui:OperationButton Content="샘플 알람 확인" Command="{Binding AcknowledgeCommand}" Margin="14,12,0,0" HorizontalAlignment="Left"/>
     <TextBlock Text="확인은 원인 해소를 뜻하지 않습니다. 이 예제는 실제 알람을 변경하지 않습니다." Style="{StaticResource SupportingText}" TextWrapping="Wrap" Margin="14,8,0,0"/>
     <Separator Margin="0,20"/><TextBlock Text="명령 요청" FontWeight="SemiBold"/><TextBlock Text="마지막 요청: 없음" Margin="0,12,0,0"/><TextBlock Text="장치 응답: 없음" Margin="0,4,0,0"/><ui:OperationButton x:Name="RequestButton" Content="운전 요청" IsEnabled="False" Margin="0,12,0,0" HorizontalAlignment="Left"/><TextBlock Text="연결이 없어 요청할 수 없습니다. 샘플 화면은 장치 명령을 보내지 않습니다." Style="{StaticResource SupportingText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
    </StackPanel>
   </ui:Inspector>
  </Grid>
 </Grid>
</Window>
