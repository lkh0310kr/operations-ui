<Window x:Class="Operations.UiCatalog.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Operations.UI.Controls;assembly=Operations.UI"
                    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Operations UI 카탈로그" Width="1380" Height="780" MinWidth="960" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource CanvasBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource FontFamilyBody}" Loaded="Window_Loaded">
    <Window.Resources>
        <!-- The catalog demonstrates low-chrome grouping; borders mark real boundaries only. -->
        <Style x:Key="SurfaceCard" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="236"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource WorkspaceSidebar}" Padding="16,22">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Margin="4,0,0,28">
                    <TextBlock Text="Operations UI" FontSize="{DynamicResource FontSectionTitle}" FontWeight="SemiBold" />
                    <TextBlock Text="공통 작업 인터페이스" Style="{StaticResource SupportingText}" Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="4,0,0,0">
                    <TextBlock Text="디자인 원칙" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontCaption}" Margin="12,0,0,12" />
                    <TextBlock Text="역할을 먼저" FontWeight="SemiBold" Margin="12,0,0,4" />
                    <TextBlock Text="각 구성 요소는 하나의 목적과 우선순위를 가집니다." Style="{StaticResource SupportingText}" FontSize="{DynamicResource FontCaption}" TextWrapping="Wrap" Margin="12,0,12,18" />
                    <TextBlock Text="상태를 함께" FontWeight="SemiBold" Margin="12,0,0,4" />
                    <TextBlock Text="색, 문구, 모양을 함께 써서 상태를 전달합니다." Style="{StaticResource SupportingText}" FontSize="{DynamicResource FontCaption}" TextWrapping="Wrap" Margin="12,0,12,18" />
                    <TextBlock Text="키보드 우선" FontWeight="SemiBold" Margin="12,0,0,4" />
                    <TextBlock Text="포커스와 조작 상태가 마우스 없이도 드러나야 합니다." Style="{StaticResource SupportingText}" FontSize="{DynamicResource FontCaption}" TextWrapping="Wrap" Margin="12,0,12,0" />
                </StackPanel>
                <Border Grid.Row="2" Style="{StaticResource InsetSurface}" Padding="12" Margin="0,18,0,0">
                    <StackPanel>
                        <TextBlock Text="키보드로 확인" FontWeight="SemiBold" FontSize="{DynamicResource FontCaption}" />
                        <TextBlock Text="Tab 키로 포커스 이동" Style="{StaticResource SupportingText}" FontSize="{DynamicResource FontCaption}" Margin="0,5,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource ToolbarSurface}" Padding="24,0">
                <DockPanel LastChildFill="False">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="UI 카탈로그" FontWeight="SemiBold" />
                        <TextBlock Text="/" Foreground="{DynamicResource TextSecondaryBrush}" Margin="12,0" />
                        <TextBlock Text="기본 테마" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <ComboBox x:Name="DensityChoice" DockPanel.Dock="Right" Width="120" Margin="8,0,0,0" SelectedIndex="1" SelectionChanged="DensityChanged" AutomationProperties.Name="Density"><ComboBoxItem Content="Compact"/><ComboBoxItem Content="Standard"/><ComboBoxItem Content="Touch"/></ComboBox>
                    <Button DockPanel.Dock="Right" Content="ERP 샘플" Click="OpenErp_Click" VerticalAlignment="Center" Margin="8,0,0,0" />
                    <Button DockPanel.Dock="Right" Content="HMI 샘플" Click="OpenHmi_Click" VerticalAlignment="Center" Margin="8,0,0,0" />
                    <Button DockPanel.Dock="Right" Content="MES 샘플" Click="OpenMes_Click" VerticalAlignment="Center" Margin="8,0,0,0" />
                    <Button x:Name="ThemeToggle" DockPanel.Dock="Right" Content="라이트 테마" Click="ThemeToggle_Click"
                            AutomationProperties.Name="라이트 테마로 전환" VerticalAlignment="Center" MinHeight="36" Padding="12,6" />
                </DockPanel>
            </Border>

            <TabControl x:Name="RootTabs" Grid.Row="1" Margin="20,12,20,16" Background="Transparent" BorderThickness="0">
              <TabItem Header="Foundation"><TabControl x:Name="FoundationTabs" Background="Transparent" BorderThickness="0">
<TabItem Header="기초"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8,4"><StackPanel MaxWidth="1040" HorizontalAlignment="Left"><Border x:Name="FoundationSection" Style="{StaticResource SurfaceCard}" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="색상과 글자" Style="{StaticResource SectionTitle}" />
                                    <TextBlock x:Name="ThemeDescription" Text="화면 계층과 정보 상태를 구분하는 다크 테마 토큰" Style="{StaticResource SupportingText}" TextWrapping="Wrap" Margin="0,4,12,0" />
                                </StackPanel>
                                <Border Grid.Column="1" Style="{StaticResource StatusBadge}" VerticalAlignment="Center"><TextBlock x:Name="ThemeBadgeLabel" Text="어두운 테마" Foreground="{DynamicResource SuccessBrush}" FontSize="{DynamicResource FontCaption}" /></Border>
                            </Grid>
                            <UniformGrid Columns="6" Margin="-4,18,-4,0">
                                <StackPanel Margin="4"><Border Height="46" Background="{DynamicResource CanvasBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="3"/><TextBlock Text="바탕" FontSize="{DynamicResource FontCaption}" Margin="0,7,0,0"/><TextBlock x:Name="CanvasHex" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontCaption}"/></StackPanel>
                                <StackPanel Margin="4"><Border Height="46" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="3"/><TextBlock Text="표면" FontSize="{DynamicResource FontCaption}" Margin="0,7,0,0"/><TextBlock x:Name="SurfaceHex" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontCaption}"/></StackPanel>
                                <StackPanel Margin="4"><Border Height="46" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="3"/><TextBlock Text="올린 표면" FontSize="{DynamicResource FontCaption}" Margin="0,7,0,0"/><TextBlock x:Name="RaisedHex" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontCaption}"/></StackPanel>
                                <StackPanel Margin="4"><Border Height="46" Background="{DynamicResource AccentBrush}" CornerRadius="3"/><TextBlock Text="선택 / 포커스" FontSize="{DynamicResource FontCaption}" Margin="0,7,0,0"/><TextBlock x:Name="AccentHex" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontCaption}"/></StackPanel>
                                <StackPanel Margin="4"><Border Height="46" Background="{DynamicResource SuccessBrush}" CornerRadius="3"/><TextBlock Text="성공" FontSize="{DynamicResource FontCaption}" Margin="0,7,0,0"/><TextBlock x:Name="SuccessHex" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontCaption}"/></StackPanel>
                                <StackPanel Margin="4"><Border Height="46" Background="{DynamicResource DangerBrush}" CornerRadius="3"/><TextBlock Text="위험" FontSize="{DynamicResource FontCaption}" Margin="0,7,0,0"/><TextBlock x:Name="DangerHex" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontCaption}"/></StackPanel>
                            </UniformGrid>
                            <Border Height="1" Background="{DynamicResource StrokeBrush}" Margin="0,18,0,14" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="화면 제목" FontSize="{DynamicResource FontPageTitle}" FontWeight="SemiBold"/><TextBlock Text="FontPageTitle · 24" Style="{StaticResource SupportingText}" Margin="0,3,0,0"/></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Text="구역 제목" FontSize="{DynamicResource FontSectionTitle}" FontWeight="SemiBold"/><TextBlock Text="FontSectionTitle · 16" Style="{StaticResource SupportingText}" Margin="0,6,0,0"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="설명과 보조 정보" FontSize="{DynamicResource FontSupporting}" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="FontSupporting · 13" Style="{StaticResource SupportingText}" Margin="0,7,0,0"/></StackPanel>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource StrokeBrush}" Margin="0,20,0,16"/>
                            <TextBlock Text="역할과 Dark / Light 매핑" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Canvas: 화면 배경  #101316 / #F4F5F7&#x0a;Panel: 작업 표면  #171B20 / #FFFFFF&#x0a;Raised: 입력·올린 표면  #1E242B / #ECEFF3&#x0a;Text.Primary: 주요 텍스트  #EDF1F5 / #18202A&#x0a;Text.Secondary: 보조 텍스트  #A7B0BC / #526071&#x0a;Border.Subtle: 구조 구분  #303842 / #D8DEE6&#x0a;Border.Control: 입력 식별  #727E8D / #7D8896&#x0a;Focus / Accent: 상호작용  #8CB4FF / #245BD6" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            <TextBlock Text="간격: 4 / 8 / 12 / 16 / 24 / 32 DIP · Control / Panel / Dialog 반경: 4 / 6 / 8 DIP" TextWrapping="Wrap" Margin="0,16,0,0"/>
                            <TextBlock Text="밀도: Compact 32 / 32, Standard 36 / 40, Touch 48 / 52 DIP (컨트롤 / 표 행 최소 높이)" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            <TextBlock Text="상태는 색상과 문구로 전달합니다. 포커스는 선택과 별개이며, High Contrast에서는 Windows 시스템 색을 사용합니다." Style="{StaticResource SupportingText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            <TextBlock Text="대비 검토: Panel의 주요 / 보조 텍스트는 Dark 15.24 / 7.89:1, Light 16.42 / 6.42:1입니다. 모든 조합을 검증한 값은 아닙니다." Style="{StaticResource SupportingText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border></StackPanel></ScrollViewer></TabItem>
<TabItem Header="텍스트">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8,4">
                    <StackPanel MaxWidth="1040" HorizontalAlignment="Left">
                    <Border Style="{StaticResource SurfaceCard}" Padding="24" Margin="4,8,4,20">
                    <StackPanel>
                    <TextBlock Text="텍스트 시스템" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="역할에 따라 크기, 굵기, 대비를 정하고 읽는 순서를 보여줍니다." Style="{StaticResource SupportingText}" Margin="0,5,0,20"/>
                    <TextBlock Text="페이지 제목 · 24 / SemiBold" Style="{StaticResource PageTitle}" Margin="0,0,0,4"/>
                    <TextBlock Text="섹션 제목 · 16 / SemiBold" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                    <TextBlock Text="카드 제목 · 15 / SemiBold" Style="{StaticResource CardTitle}" Margin="0,0,0,4"/>
                    <TextBlock Text="본문 · 14 / Regular — 상태와 다음 행동을 설명하는 문장" Style="{StaticResource BodyText}" Margin="0,0,0,4"/>
                    <TextBlock Text="보조 설명 · 13 / Regular" Style="{StaticResource SupportingText}" Margin="0,0,0,4"/>
                    <TextBlock Text="라벨 · 12 / SemiBold" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                    <TextBlock Text="캡션 · 12 / Regular — 날짜, 단위, 메타데이터" Style="{StaticResource CaptionText}"/>
                    <TextBlock Margin="0,8,0,0"><Run Text="링크와 코드 · "/><Hyperlink Click="TextLink_Click">도움말 링크</Hyperlink><Run Text=" · "/><Run Style="{StaticResource InlineCode}" Text="Variant=&quot;Primary&quot;"/></TextBlock>
                    <TextBlock x:Name="TextLinkStatus" Text="링크를 눌러 동작을 확인하세요." Style="{StaticResource CaptionText}" Margin="0,4,0,0"/>
                    <Border Height="1" Background="{DynamicResource StrokeBrush}" Margin="0,20"/>
                    <TextBlock Text="문장 길이와 줄바꿈" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="긴 안내문은 제한된 폭에서 자연스럽게 줄바꿈하고, 중요한 수치와 단위를 가까이 배치합니다." MaxWidth="680" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <TextBlock Text="토큰: FontPageTitle · FontSectionTitle · FontBody · FontCaption" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontCaption}" Margin="0,18,0,0"/>
                    </StackPanel>
                    </Border>
                    </StackPanel>
                    </ScrollViewer>
                    </TabItem>
              </TabControl></TabItem>
              <TabItem Header="Component"><TabControl x:Name="ComponentTabs" Background="Transparent" BorderThickness="0">
<TabItem Header="Action"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8,4"><StackPanel MaxWidth="1040" HorizontalAlignment="Left"><Border x:Name="ControlsSection" Style="{StaticResource SurfaceCard}" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="버튼 계층과 상태" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="호버, 누름, 키보드 포커스, 비활성 상태를 직접 확인하세요." Style="{StaticResource SupportingText}" Margin="0,4,0,14" />
                            <WrapPanel>
                                <ui:OperationButton x:Name="KeyboardDemoButton" Content="기본" Variant="Standard" Click="DemoButton_Click" Margin="0,0,8,8" />
                                <ui:OperationButton Content="주요 동작" Variant="Primary" Margin="0,0,8,8" />
                                <ui:OperationButton Content="사용할 수 없음" IsEnabled="False" Margin="0,0,8,8" />
                                <ui:OperationButton Content="저장" IsBusy="True" Click="DemoButton_Click" BusyContent="저장 중" Margin="0,0,8,8" />
                                <Button Content="연결 해제" Style="{StaticResource DangerButton}" Click="DemoButton_Click" Margin="0,0,8,8" />
                                <Button Content="⋮" Style="{StaticResource IconActionButton}" ToolTip="추가 동작"
                                        AutomationProperties.Name="추가 동작" Margin="0,0,8,8" />
                            </WrapPanel>
                            <TextBlock Text="사용 불가 이유: 이 샘플에서는 권한이 없습니다." Style="{StaticResource SupportingText}" TextWrapping="Wrap"/>
                            <WrapPanel Margin="0,12,0,0"><ui:OperationButton x:Name="CancelableStart" Content="취소 가능한 작업 시작" BusyContent="작업 중…" Click="BeginCancelable_Click" Margin="0,0,8,8"/><Button x:Name="CancelDemoButton" Content="작업 취소" Click="CancelDemo_Click" IsEnabled="False" Margin="0,0,8,8"/></WrapPanel>
                            <TextBlock x:Name="CancelableStatus" Text="샘플 작업이 시작되지 않았습니다." Style="{StaticResource SupportingText}"/>
<StackPanel Margin="0,8,0,0"><TextBlock Text="크기 단계는 위의 밀도 선택과 함께 변경됩니다." Style="{StaticResource SupportingText}" Margin="0,0,0,6"/><WrapPanel><ui:OperationButton Content="Compact" Size="Compact" Margin="0,0,8,8"/><ui:OperationButton Content="Standard" Size="Standard" Margin="0,0,8,8"/><ui:OperationButton Content="Large" Size="Large" Margin="0,0,8,8"/><ui:OperationButton Content="Apply" AutomationProperties.Name="Apply changes" Margin="0,0,8,8"/><ui:OperationButton x:Name="FocusPreviewButton" Content="Focus" AutomationProperties.Name="Keyboard focus preview" Margin="0,0,8,8"/></WrapPanel></StackPanel>
<TextBlock x:Name="ButtonInteractionStatus" Text="일반 버튼을 눌러 작동을 확인하세요." Style="{StaticResource SupportingText}" Margin="0,2,0,8"/>


                        </StackPanel>
                    </Border></StackPanel></ScrollViewer></TabItem>
<TabItem Header="입력"><ScrollViewer x:Name="InputScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8,4"><StackPanel MaxWidth="1040" HorizontalAlignment="Left"><Border Style="{StaticResource SurfaceCard}" Padding="24" Margin="4,8,4,20"><StackPanel><TextBlock Text="입력과 선택" Style="{StaticResource SectionTitle}"/><TextBlock Text="필드 라벨, 도움말, 필수 표시, 오류 안내를 한 구성 요소로 재사용합니다." Style="{StaticResource SupportingText}" Margin="0,5,0,18"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><ui:FormField Label="이름" HelpText="사용자에게 보일 이름을 입력합니다." IsRequired="True" Margin="0,0,0,12"><TextBox Text="예: 기본 입력" Width="290" HorizontalAlignment="Left"/></ui:FormField><ui:FormField Label="옵션 선택" HelpText="목록에서 하나를 선택합니다." Margin="0,0,0,8"><ComboBox x:Name="FocusPreviewCombo" SelectedIndex="0" Width="290" HorizontalAlignment="Left"><ComboBoxItem Content="선택하세요"/><ComboBoxItem Content="옵션 A"/><ComboBoxItem Content="옵션 B"/></ComboBox></ui:FormField><ui:FormField Label="Editable search" HelpText="Select or type a value." Margin="0,0,0,8"><ComboBox x:Name="EditablePreview" IsEditable="True" IsTextSearchEnabled="False" Width="290" HorizontalAlignment="Left"><ComboBoxItem Content="Sample A"/><ComboBoxItem Content="Sample B"/></ComboBox></ui:FormField><ui:FormField Label="Invalid selection" IsInvalid="True" ErrorMessage="Select a valid value." Margin="0,0,0,8"><ComboBox x:Name="InvalidCombo" SelectedIndex="0" Width="290" HorizontalAlignment="Left"><ComboBoxItem Content="Invalid value"/><ComboBoxItem Content="Valid value"/></ComboBox></ui:FormField><CheckBox x:Name="FocusPreviewCheckBox" Content="이 설정 사용" IsChecked="True" Margin="0,8,0,0"/><CheckBox Content="사용 불가" IsEnabled="False"/><TextBlock Text="선택 방식" Style="{StaticResource SupportingText}" Margin="0,8,0,0"/><RadioButton x:Name="FocusPreviewRadio" Content="하나 선택" GroupName="InputPreview" IsChecked="True"/><RadioButton Content="다른 선택" GroupName="InputPreview"/><TextBlock Text="토글" Style="{StaticResource SupportingText}" Margin="0,8,0,0"/><ui:OperationSwitch x:Name="FocusPreviewSwitch" Content="자동 설정" IsChecked="True"/><ui:OperationSwitch Content="수동 설정"/><ui:OperationSwitch Content="사용 불가" IsEnabled="False"/></StackPanel><ui:FormField x:Name="ValidationExample" Grid.Column="1" Label="값" IsRequired="True" IsInvalid="True" ErrorMessage="필수 값을 입력하세요." Margin="12,0,0,0"><TextBox Text="값을 확인하세요" Width="290" HorizontalAlignment="Left"/></ui:FormField></Grid><TextBlock Text="키보드: Tab 이동 / Space 체크 / 방향키 선택 / 포커스 / 비활성 / 오류" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontCaption}" Margin="0,14,0,0"/></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
<TabItem Header="알림"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8,4"><StackPanel MaxWidth="1040" HorizontalAlignment="Left"><Border x:Name="FeedbackSection" Style="{StaticResource SurfaceCard}" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="상태와 알림" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="상태는 색상만으로 구분하지 않고 짧은 설명을 함께 제공합니다." Style="{StaticResource SupportingText}" Margin="0,4,0,12" />
                            <ui:NotificationBanner Title="안내" Message="이 메시지는 사용자의 작업을 막지 않는 정보를 전달합니다." Severity="Information" IsDismissible="False" Margin="0,0,0,8"/><ui:NotificationBanner Title="정상" Message="모든 작업이 정상적으로 실행 중입니다." Severity="Success" IsDismissible="False" Margin="0,0,0,8" />
                            <ui:NotificationBanner Title="확인 필요" Message="일부 작업의 응답이 평소보다 느립니다." Severity="Warning" IsDismissible="False" Margin="0,0,0,8" />
                            <ui:NotificationBanner x:Name="ErrorNotification" Title="오류" Message="연결을 확인하고 다시 시도하세요." Severity="Error" DismissRequested="Notification_DismissRequested" />
                        </StackPanel>
                    </Border></StackPanel></ScrollViewer></TabItem>
<TabItem Header="상태와 지표"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8,4"><StackPanel MaxWidth="1040" HorizontalAlignment="Left"><Border x:Name="OperationsSection" Style="{StaticResource SurfaceCard}" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="운영 상태와 값" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="설비·연결·품질·최신성·알람 확인은 서로 독립적인 정보입니다. 다음 항목은 샘플입니다." Style="{StaticResource SupportingText}" TextWrapping="Wrap" Margin="0,4,0,16"/>
                            <WrapPanel><ui:StatusIndicator Content="마지막 확인: 운전 중" Margin="0,0,24,8"/><ui:StatusIndicator Content="연결: 끊김" Tone="Warning" Margin="0,0,24,8"/><ui:StatusIndicator Content="최신성: 오래됨" Tone="Warning" Margin="0,0,24,8"/><ui:StatusIndicator Content="알람: 활성 · 확인됨" Tone="Warning" Margin="0,0,24,8"/></WrapPanel>
                            <Grid Margin="0,16,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <ui:ValueDisplay Label="압력" ValueText="−12.5" Unit="kPa" RangeText="기준 −20.0–0.0 kPa" QualityText="품질: 양호" FreshnessText="최신성: 오래됨" TimestampText="마지막 수신 10:24:00"/>
                                <ui:ValueDisplay Grid.Column="1" Label="유량" Unit="L/min" QualityText="품질: 신뢰할 수 없음" FreshnessText="최신성: 알 수 없음" TimestampText="수신 값 없음"/>
                            </Grid>
