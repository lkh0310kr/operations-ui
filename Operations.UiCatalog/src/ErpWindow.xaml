<Window x:Class="Operations.UiCatalog.ErpWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="clr-namespace:Operations.UI.Controls;assembly=Operations.UI"
 Title="ERP 재고 관리 · 샘플" Width="1280" Height="800" MinWidth="960" MinHeight="650"
 Background="{DynamicResource Ops.Brush.Surface.Canvas}" Foreground="{DynamicResource Ops.Brush.Text.Primary}"
 FontFamily="{DynamicResource FontFamilyBody}" UseLayoutRounding="True">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,16"><TextBlock Text="ERP / 자재 관리" Style="{StaticResource SupportingText}"/><TextBlock Text="재고 현황" Style="{StaticResource PageTitle}" Margin="0,8,0,0"/><TextBlock Text="샘플 데이터 · 변경 사항은 이 창의 메모리에만 저장됩니다" Style="{StaticResource SupportingText}" Margin="0,4,0,0"/></StackPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="460"/><ColumnDefinition Width="16"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="품목 목록" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
    <DataGrid x:Name="InventoryGrid" Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" IsEnabled="{Binding CanEdit}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" EnableRowVirtualization="True" EnableColumnVirtualization="True">
     <DataGrid.Columns>
      <DataGridTextColumn Header="품목 코드" Binding="{Binding Code}" Width="1.1*" ElementStyle="{StaticResource Ops.DataGrid.CellText}"/>
      <DataGridTextColumn Header="품목명" Binding="{Binding Name}" Width="1.5*" ElementStyle="{StaticResource Ops.DataGrid.CellText}"/>
      <DataGridTextColumn Header="재고 · EA" Binding="{Binding Quantity, StringFormat=N0}" Width="*" ElementStyle="{StaticResource Ops.DataGrid.NumericCell}" HeaderStyle="{StaticResource Ops.DataGrid.NumericHeader}"/>
      <DataGridTextColumn Header="단가 · KRW" Binding="{Binding UnitPrice, StringFormat=N0}" Width="*" ElementStyle="{StaticResource Ops.DataGrid.NumericCell}" HeaderStyle="{StaticResource Ops.DataGrid.NumericHeader}"/>
      <DataGridTextColumn Header="재고 금액 · KRW" Binding="{Binding Amount, StringFormat=N0}" Width="1.2*" ElementStyle="{StaticResource Ops.DataGrid.NumericCell}" HeaderStyle="{StaticResource Ops.DataGrid.NumericHeader}"/>
     </DataGrid.Columns>
    </DataGrid>
    <TextBlock Grid.Row="2" Text="수량과 금액은 샘플이며 실제 재고 평가액이 아닙니다." Style="{StaticResource SupportingText}" Margin="0,12,0,0" TextWrapping="Wrap"/>
   </Grid>
   <ui:Inspector Grid.Column="2" Header="품목 상세 및 편집" AutomationProperties.Name="선택한 품목 상세 및 편집">
    <StackPanel>
     <ui:FormField Label="품목 코드" HelpText="품목 코드는 읽기 전용입니다."><TextBox x:Name="CodeInput" Text="{Binding Selected.Code, Mode=OneWay}" IsReadOnly="True"/></ui:FormField>
     <ui:FormField x:Name="NameField" Label="품목명" IsRequired="True" HelpText="1–80자로 입력하세요." IsInvalid="{Binding NameInvalid}" ErrorMessage="{Binding NameError}" Margin="0,16,0,0"><TextBox x:Name="NameInput" Text="{Binding DraftName, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsBusy}"/></ui:FormField>
     <ui:FormField x:Name="QuantityField" Label="발주 기준 수량 · EA" IsRequired="True" HelpText="0–100,000 사이의 정수를 입력하세요." IsInvalid="{Binding QuantityInvalid}" ErrorMessage="{Binding QuantityError}" Margin="0,16,0,0"><TextBox x:Name="QuantityInput" Text="{Binding DraftReorder, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsBusy}"/></ui:FormField>
     <CheckBox Content="샘플 저장 실패 시뮬레이션" IsChecked="{Binding SimulateFailure}" IsEnabled="{Binding CanEdit}" Margin="0,16,0,0"/>
     <ui:OperationButton x:Name="SaveButton" Content="변경 저장" BusyContent="저장 중…" Variant="Primary" IsBusy="{Binding IsBusy}" Command="{Binding SaveCommand}" HorizontalAlignment="Left" Margin="0,16,0,0"/>
     <TextBlock x:Name="SaveResult" Text="{Binding SaveMessage}" TextWrapping="Wrap" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite"/>
     <TextBlock Text="저장 전 입력은 품목별 초안으로 유지됩니다. 화면을 닫으면 샘플 변경이 사라집니다." Style="{StaticResource SupportingText}" TextWrapping="Wrap" Margin="0,12,0,0"/>
    </StackPanel>
   </ui:Inspector>
  </Grid>
 </Grid>
</Window>
