<Window x:Class="Operations.UiCatalog.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Operations.UI.Controls;assembly=Operations.UI"
                    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Operations UI 카탈로그" Width="1380" Height="780" MinWidth="960" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource CanvasBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="Segoe UI" Loaded="Window_Loaded">
    <Window.Resources>
        <!-- The catalog demonstrates low-chrome grouping; borders mark real boundaries only. -->
        <Style x:Key="SurfaceCard" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="236"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource WorkspaceSidebar}" Padding="16,22">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Margin="4,0,0,28">
                    <TextBlock Text="Operations UI" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="공통 작업 인터페이스" Style="{StaticResource SupportingText}" Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel Grid.Row="1">
                    <TextBlock Text="기초" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="12,0,0,8" />
                    <Button Content="색상과 글자" Tag="FoundationSection" Click="NavigateToSection_Click" Style="{StaticResource SidebarItem}" />
                    <Button Content="버튼과 입력" Tag="ControlsSection" Click="NavigateToSection_Click" Style="{StaticResource SidebarItem}" />
                    <Button Content="상태와 알림" Tag="FeedbackSection" Click="NavigateToSection_Click" Style="{StaticResource SidebarItem}" />
                    <Button Content="목록과 표" Tag="DataSection" Click="NavigateToSection_Click" Style="{StaticResource SidebarItem}" />
                    <Button Content="작업 공간 구성" Tag="WorkspaceSection" Click="NavigateToSection_Click" Style="{StaticResource SidebarItem}" />
                    <Button Content="대화상자" Tag="DialogSection" Click="NavigateToSection_Click" Style="{StaticResource SidebarItem}" />
                </StackPanel>
                <Border Grid.Row="2" Style="{StaticResource InsetSurface}" Padding="12" Margin="0,18,0,0">
                    <StackPanel>
                        <TextBlock Text="키보드로 확인" FontWeight="SemiBold" FontSize="12" />
                        <TextBlock Text="Tab 키로 포커스 이동" Style="{StaticResource SupportingText}" FontSize="11" Margin="0,5,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource ToolbarSurface}" Padding="24,0">
                <DockPanel LastChildFill="False">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="UI 카탈로그" FontWeight="SemiBold" />
                        <TextBlock Text="/" Foreground="{DynamicResource TextSecondaryBrush}" Margin="12,0" />
                        <TextBlock Text="기본 테마" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Right" Text="다크 테마 · 상호작용 상태" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <ScrollViewer x:Name="CatalogScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,24">
                <StackPanel x:Name="CatalogContent" MaxWidth="1040" HorizontalAlignment="Left">
                    <TextBlock Text="공통 인터페이스" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="운영 도구와 데스크톱 작업 화면에서 재사용하는 시각 토큰과 구성 요소입니다." Style="{StaticResource SupportingText}" Margin="0,6,0,22" />

                    <Border x:Name="FoundationSection" Style="{StaticResource SurfaceCard}" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <StackPanel>
                                    <TextBlock Text="색상과 글자" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="화면 계층과 정보 상태를 구분하는 다크 테마 토큰" Style="{StaticResource SupportingText}" Margin="0,4,0,0" />
                                </StackPanel>
                                <Border DockPanel.Dock="Right" Style="{StaticResource StatusBadge}" VerticalAlignment="Center"><TextBlock Text="어두운 테마" Foreground="{DynamicResource SuccessBrush}" FontSize="12" /></Border>
                            </DockPanel>
                            <UniformGrid Columns="6" Margin="-4,18,-4,0">
                                <StackPanel Margin="4"><Border Height="46" Background="{DynamicResource CanvasBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="3"/><TextBlock Text="바탕" FontSize="12" Margin="0,7,0,0"/><TextBlock Text="#20272B" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/></StackPanel>
                                <StackPanel Margin="4"><Border Height="46" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="3"/><TextBlock Text="표면" FontSize="12" Margin="0,7,0,0"/><TextBlock Text="#2A3338" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/></StackPanel>
                                <StackPanel Margin="4"><Border Height="46" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="3"/><TextBlock Text="올린 표면" FontSize="12" Margin="0,7,0,0"/><TextBlock Text="#343E43" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/></StackPanel>
                                <StackPanel Margin="4"><Border Height="46" Background="{DynamicResource AccentBrush}" CornerRadius="3"/><TextBlock Text="주요 동작" FontSize="12" Margin="0,7,0,0"/><TextBlock Text="#4C8DFF" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/></StackPanel>
                                <StackPanel Margin="4"><Border Height="46" Background="{DynamicResource SuccessBrush}" CornerRadius="3"/><TextBlock Text="성공" FontSize="12" Margin="0,7,0,0"/><TextBlock Text="#42B883" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/></StackPanel>
                                <StackPanel Margin="4"><Border Height="46" Background="{DynamicResource DangerBrush}" CornerRadius="3"/><TextBlock Text="위험" FontSize="12" Margin="0,7,0,0"/><TextBlock Text="#E36B65" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/></StackPanel>
                            </UniformGrid>
                            <Border Height="1" Background="{DynamicResource StrokeBrush}" Margin="0,18,0,14" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="화면 제목" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="26 · SemiBold" Style="{StaticResource SupportingText}" FontSize="11" Margin="0,3,0,0"/></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Text="구역 제목" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="17 · SemiBold" Style="{StaticResource SupportingText}" FontSize="11" Margin="0,6,0,0"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="설명과 보조 정보" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="13 · Regular" Style="{StaticResource SupportingText}" FontSize="11" Margin="0,7,0,0"/></StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border x:Name="ControlsSection" Style="{StaticResource SurfaceCard}" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="버튼과 입력" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="호버, 누름, 키보드 포커스, 비활성 상태를 직접 확인하세요." Style="{StaticResource SupportingText}" Margin="0,4,0,14" />
                            <WrapPanel>
                                <ui:OperationButton Content="기본" Variant="Standard" Margin="0,0,8,8" />
                                <ui:OperationButton Content="주요 동작" Variant="Primary" Margin="0,0,8,8" />
                                <ui:OperationButton Content="안전 확인" Variant="Success" Margin="0,0,8,8" />
                                <ui:OperationButton Content="주의 동작" Variant="Warning" Margin="0,0,8,8" />
                                <ui:OperationButton Content="정지" Variant="Danger" Margin="0,0,8,8" />
                                <ui:OperationButton Content="사용할 수 없음" IsEnabled="False" Margin="0,0,8,8" />
                            </WrapPanel>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0"><TextBlock Text="텍스트 입력" Style="{StaticResource SupportingText}" Margin="0,0,0,6"/><TextBox Text="작업 이름을 입력하세요" /></StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0"><TextBlock Text="항목 선택" Style="{StaticResource SupportingText}" Margin="0,0,0,6"/><ComboBox SelectedIndex="0"><ComboBoxItem Content="설비 01 · 연결됨"/><ComboBoxItem Content="설비 02 · 대기 중"/><ComboBoxItem Content="설비 03 · 연결 끊김"/></ComboBox></StackPanel>
                                <StackPanel Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Bottom"><CheckBox Content="작업 기록 사용" IsChecked="True"/><CheckBox Content="선택 항목" IsChecked="False"/></StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border x:Name="FeedbackSection" Style="{StaticResource SurfaceCard}" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="상태와 알림" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="상태는 색상만으로 구분하지 않고 짧은 설명을 함께 제공합니다." Style="{StaticResource SupportingText}" Margin="0,4,0,12" />
                            <ui:NotificationBanner Title="정상" Message="모든 작업이 정상적으로 실행 중입니다." Severity="Success" IsDismissible="False" Margin="0,0,0,8" />
                            <ui:NotificationBanner Title="확인 필요" Message="일부 작업의 응답이 평소보다 느립니다." Severity="Warning" IsDismissible="False" Margin="0,0,0,8" />
                            <ui:NotificationBanner x:Name="ErrorNotification" Title="오류" Message="연결을 확인하고 다시 시도하세요." Severity="Error" DismissRequested="Notification_DismissRequested" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="OperationsSection" Style="{StaticResource SurfaceCard}" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <StackPanel>
                                    <TextBlock Text="설비 상태와 핵심 지표" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="운전 상태는 색상과 텍스트로, 수치는 단위와 기준을 함께 표시합니다." Style="{StaticResource SupportingText}" Margin="0,4,0,0" />
                                </StackPanel>
                                <wpfui:InfoBar DockPanel.Dock="Right" Title="확인 필요" Message="검사 라인 02 · 입력 프레임이 2초간 수신되지 않았습니다."
                                               Severity="Warning" IsOpen="True" IsClosable="False" Margin="16,0,0,0" />
                            </DockPanel>
                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <ui:MetricTile Label="검사 속도" Value="182" Unit="ppm" Context="목표 180 · 최근 1분" Margin="0,0,8,0" />
                                <ui:MetricTile Grid.Column="1" Label="합격률" Value="99.4" Unit="%" Context="최근 1,000개" Margin="4,0" />
                                <ui:MetricTile Grid.Column="2" Label="평균 추론" Value="3.8" Unit="ms" Context="최근 성공 검사" Margin="4,0" />
                                <ui:MetricTile Grid.Column="3" Label="검사 장치" Value="02" Unit="" Context="라인 02 · 프레임 대기 중" Margin="8,0,0,0" />
                            </Grid>
                            <TextBlock Text="상태 표현 예시" Style="{StaticResource SupportingText}" FontSize="12" Margin="0,14,0,0" />
                            <WrapPanel Margin="0,12,0,0">
                                <ui:StatusBadge Content="연결 끊김" State="Offline" Margin="0,0,8,8" />
                                <ui:StatusBadge Content="준비 완료" State="Ready" Margin="0,0,8,8" />
                                <ui:StatusBadge Content="검사 중" State="Running" Margin="0,0,8,8" />
                                <ui:StatusBadge Content="확인 필요" State="Warning" Margin="0,0,8,8" />
                                <ui:StatusBadge Content="장비 오류" State="Fault" Margin="0,0,8,8" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border x:Name="DataSection" Style="{StaticResource SurfaceCard}" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <StackPanel><TextBlock Text="목록과 표" Style="{StaticResource SectionTitle}"/><TextBlock Text="행 동작과 선택 상태를 확인하는 공통 데이터 표시" Style="{StaticResource SupportingText}" Margin="0,4,0,0"/></StackPanel>
                                <Button Content="새 작업" Style="{StaticResource PrimaryButton}" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <ListBox SelectedIndex="1" Height="190" Margin="0,0,14,0">
                                    <ListBoxItem Content="조립 구역 · 설비 01"/><ListBoxItem Content="검수 구역 · 설비 02"/><ListBoxItem Content="포장 구역 · 설비 03"/>
                                </ListBox>
                                <DataGrid x:Name="SampleGrid" Grid.Column="1" Height="190" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="작업" Binding="{Binding Name}" Width="1.2*"/>
                                        <DataGridTextColumn Header="구역" Binding="{Binding Area}" Width="1*"/>
                                        <DataGridTextColumn Header="상태" Binding="{Binding Status}" Width="0.9*"/>
                                        <DataGridTextColumn Header="최근 변경" Binding="{Binding Updated}" Width="0.9*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border x:Name="WorkspaceSection" Style="{StaticResource SurfaceCard}" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="작업 공간 구성" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="탐색, 화면 제목, 본문, 상태 표시줄을 조합한 데스크톱 작업 화면" Style="{StaticResource SupportingText}" Margin="0,4,0,14" />
                            <ui:WorkspaceShell Height="248" NavigationWidth="156" ClipToBounds="True">
                                <ui:WorkspaceShell.NavigationContent>
                                    <StackPanel Margin="10"><TextBlock Text="작업" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="8,6,0,8"/><Button Content="개요" Style="{StaticResource SidebarItem}" MinHeight="34" Padding="8,6" HorizontalContentAlignment="Left"/><Button Content="활동 내역" Style="{StaticResource SidebarItem}" MinHeight="34" Padding="8,6" HorizontalContentAlignment="Left"/><Button Content="설정" Style="{StaticResource SidebarItem}" MinHeight="34" Padding="8,6" HorizontalContentAlignment="Left"/></StackPanel>
                                </ui:WorkspaceShell.NavigationContent>
                                <ui:WorkspaceShell.HeaderContent>
                                    <DockPanel LastChildFill="True"><TextBlock Text="최근 갱신 · 방금" Foreground="{DynamicResource TextSecondaryBrush}" DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="11"/><TextBlock Text="운영 개요" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
                                </ui:WorkspaceShell.HeaderContent>
                                <ui:WorkspaceShell.StatusContent>
                                    <TextBlock Text="연결됨 · 로컬 작업 공간" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" VerticalAlignment="Center" />
                                </ui:WorkspaceShell.StatusContent>
                                <Grid Margin="16,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource SurfaceCard}" Padding="12" Margin="0,0,8,0"><StackPanel><TextBlock Text="진행 중" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/><TextBlock Text="12" FontSize="24" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border>
                                    <Border Grid.Column="1" Style="{StaticResource SurfaceCard}" Padding="12" Margin="4,0"><StackPanel><TextBlock Text="완료" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/><TextBlock Text="38" FontSize="24" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border>
                                    <Border Grid.Column="2" Style="{StaticResource SurfaceCard}" Padding="12" Margin="8,0,0,0"><StackPanel><TextBlock Text="확인 필요" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/><TextBlock Text="2" Foreground="{DynamicResource WarningBrush}" FontSize="24" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border>
                                </Grid>
                            </ui:WorkspaceShell>
                        </StackPanel>
                    </Border>

                    <Border x:Name="DialogSection" Style="{StaticResource SurfaceCard}" Padding="20" Margin="0,0,0,24">
                        <StackPanel>
                            <TextBlock Text="대화상자" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="필수 정보를 간결하게 보여주고 동작의 결과를 명확히 하는 확인 패턴" Style="{StaticResource SupportingText}" Margin="0,4,0,14" />
                            <ui:DialogHost x:Name="DialogPreviewHost" Height="232" IsDialogOpen="True">
                                <ui:DialogHost.Content>
                                    <Border Background="{DynamicResource CanvasBrush}" Padding="18" CornerRadius="4"><TextBlock Text="현재 창 위에 대화상자 오버레이를 표시합니다." Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" /></Border>
                                </ui:DialogHost.Content>
                                <ui:DialogHost.DialogContent>
                                    <StackPanel>
                                        <TextBlock Text="작업을 종료할까요?" FontSize="17" FontWeight="SemiBold" />
                                        <TextBlock Text="진행 중인 변경 사항은 자동으로 저장됩니다." Style="{StaticResource SupportingText}" TextWrapping="Wrap" Margin="0,8,0,18" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="계속 작업" Click="ClosePreviewDialog_Click" Margin="0,0,8,0"/><Button Content="종료" Click="ClosePreviewDialog_Click" Style="{StaticResource PrimaryButton}"/></StackPanel>
                                    </StackPanel>
                                </ui:DialogHost.DialogContent>
                            </ui:DialogHost>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0" Padding="18,0">
                <DockPanel><TextBlock Text="Operations UI · 공통 WPF 구성 요소" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" VerticalAlignment="Center"/><TextBlock DockPanel.Dock="Right" Text="카탈로그 미리보기" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" VerticalAlignment="Center"/></DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
