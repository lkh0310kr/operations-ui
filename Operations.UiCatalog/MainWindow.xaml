<Window x:Class="Operations.UiCatalog.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Operations.UI.Controls;assembly=Operations.UI"
                    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Operations UI 카탈로그" Width="1380" Height="780" MinWidth="960" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource CanvasBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="Segoe UI" Loaded="Window_Loaded">
    <Window.Resources>
        <!-- The catalog demonstrates low-chrome grouping; borders mark real boundaries only. -->
        <Style x:Key="SurfaceCard" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="236"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource WorkspaceSidebar}" Padding="16,22">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Margin="4,0,0,28">
                    <TextBlock Text="Operations UI" FontSize="{DynamicResource FontSectionTitle}" FontWeight="SemiBold" />
                    <TextBlock Text="공통 작업 인터페이스" Style="{StaticResource SupportingText}" Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="4,0,0,0">
                    <TextBlock Text="디자인 원칙" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontCaption}" Margin="12,0,0,12" />
                    <TextBlock Text="역할을 먼저" FontWeight="SemiBold" Margin="12,0,0,4" />
                    <TextBlock Text="각 구성 요소는 하나의 목적과 우선순위를 가집니다." Style="{StaticResource SupportingText}" FontSize="{DynamicResource FontCaption}" TextWrapping="Wrap" Margin="12,0,12,18" />
                    <TextBlock Text="상태를 함께" FontWeight="SemiBold" Margin="12,0,0,4" />
                    <TextBlock Text="색, 문구, 모양을 함께 써서 상태를 전달합니다." Style="{StaticResource SupportingText}" FontSize="{DynamicResource FontCaption}" TextWrapping="Wrap" Margin="12,0,12,18" />
                    <TextBlock Text="키보드 우선" FontWeight="SemiBold" Margin="12,0,0,4" />
                    <TextBlock Text="포커스와 조작 상태가 마우스 없이도 드러나야 합니다." Style="{StaticResource SupportingText}" FontSize="{DynamicResource FontCaption}" TextWrapping="Wrap" Margin="12,0,12,0" />
                </StackPanel>
                <Border Grid.Row="2" Style="{StaticResource InsetSurface}" Padding="12" Margin="0,18,0,0">
                    <StackPanel>
                        <TextBlock Text="키보드로 확인" FontWeight="SemiBold" FontSize="{DynamicResource FontCaption}" />
                        <TextBlock Text="Tab 키로 포커스 이동" Style="{StaticResource SupportingText}" FontSize="{DynamicResource FontCaption}" Margin="0,5,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource ToolbarSurface}" Padding="24,0">
                <DockPanel LastChildFill="False">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="UI 카탈로그" FontWeight="SemiBold" />
                        <TextBlock Text="/" Foreground="{DynamicResource TextSecondaryBrush}" Margin="12,0" />
                        <TextBlock Text="기본 테마" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Right" Text="다크 테마 · 상호작용 상태" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <TabControl x:Name="CatalogTabs" Grid.Row="1" Margin="20,12,20,16" Background="Transparent" BorderThickness="0">
<TabItem Header="기초"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8,4"><StackPanel MaxWidth="1040" HorizontalAlignment="Left"><Border x:Name="FoundationSection" Style="{StaticResource SurfaceCard}" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <StackPanel>
                                    <TextBlock Text="색상과 글자" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="화면 계층과 정보 상태를 구분하는 다크 테마 토큰" Style="{StaticResource SupportingText}" Margin="0,4,0,0" />
                                </StackPanel>
                                <Border DockPanel.Dock="Right" Style="{StaticResource StatusBadge}" VerticalAlignment="Center"><TextBlock Text="어두운 테마" Foreground="{DynamicResource SuccessBrush}" FontSize="{DynamicResource FontCaption}" /></Border>
                            </DockPanel>
                            <UniformGrid Columns="6" Margin="-4,18,-4,0">
                                <StackPanel Margin="4"><Border Height="46" Background="{DynamicResource CanvasBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="3"/><TextBlock Text="바탕" FontSize="{DynamicResource FontCaption}" Margin="0,7,0,0"/><TextBlock Text="#20272B" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontCaption}"/></StackPanel>
                                <StackPanel Margin="4"><Border Height="46" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="3"/><TextBlock Text="표면" FontSize="{DynamicResource FontCaption}" Margin="0,7,0,0"/><TextBlock Text="#2A3338" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontCaption}"/></StackPanel>
                                <StackPanel Margin="4"><Border Height="46" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="3"/><TextBlock Text="올린 표면" FontSize="{DynamicResource FontCaption}" Margin="0,7,0,0"/><TextBlock Text="#343E43" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontCaption}"/></StackPanel>
                                <StackPanel Margin="4"><Border Height="46" Background="{DynamicResource AccentBrush}" CornerRadius="3"/><TextBlock Text="주요 동작" FontSize="{DynamicResource FontCaption}" Margin="0,7,0,0"/><TextBlock Text="#4C8DFF" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontCaption}"/></StackPanel>
                                <StackPanel Margin="4"><Border Height="46" Background="{DynamicResource SuccessBrush}" CornerRadius="3"/><TextBlock Text="성공" FontSize="{DynamicResource FontCaption}" Margin="0,7,0,0"/><TextBlock Text="#42B883" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontCaption}"/></StackPanel>
                                <StackPanel Margin="4"><Border Height="46" Background="{DynamicResource DangerBrush}" CornerRadius="3"/><TextBlock Text="위험" FontSize="{DynamicResource FontCaption}" Margin="0,7,0,0"/><TextBlock Text="#E36B65" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontCaption}"/></StackPanel>
                            </UniformGrid>
                            <Border Height="1" Background="{DynamicResource StrokeBrush}" Margin="0,18,0,14" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="화면 제목" FontSize="{DynamicResource FontPageTitle}" FontWeight="SemiBold"/><TextBlock Text="FontPageTitle · 26" Style="{StaticResource SupportingText}" Margin="0,3,0,0"/></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Text="구역 제목" FontSize="{DynamicResource FontSectionTitle}" FontWeight="SemiBold"/><TextBlock Text="FontSectionTitle · 18" Style="{StaticResource SupportingText}" Margin="0,6,0,0"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="설명과 보조 정보" FontSize="{DynamicResource FontSupporting}" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="FontSupporting · 13" Style="{StaticResource SupportingText}" Margin="0,7,0,0"/></StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border></StackPanel></ScrollViewer></TabItem>
<TabItem Header="텍스트">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8,4">
                    <StackPanel MaxWidth="1040" HorizontalAlignment="Left">
                    <Border Style="{StaticResource SurfaceCard}" Padding="24" Margin="4,8,4,20">
                    <StackPanel>
                    <TextBlock Text="텍스트 시스템" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="역할에 따라 크기, 굵기, 대비를 정하고 읽는 순서를 보여줍니다." Style="{StaticResource SupportingText}" Margin="0,5,0,20"/>
                    <TextBlock Text="페이지 제목 · 26 / SemiBold" Style="{StaticResource PageTitle}" Margin="0,0,0,4"/>
                    <TextBlock Text="섹션 제목 · 18 / SemiBold" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                    <TextBlock Text="카드 제목 · 15 / SemiBold" Style="{StaticResource CardTitle}" Margin="0,0,0,4"/>
                    <TextBlock Text="본문 · 14 / Regular — 상태와 다음 행동을 설명하는 문장" Style="{StaticResource BodyText}" Margin="0,0,0,4"/>
                    <TextBlock Text="보조 설명 · 13 / Regular" Style="{StaticResource SupportingText}" Margin="0,0,0,4"/>
                    <TextBlock Text="라벨 · 12 / SemiBold" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                    <TextBlock Text="캡션 · 12 / Regular — 날짜, 단위, 메타데이터" Style="{StaticResource CaptionText}"/>
                    <Border Height="1" Background="{DynamicResource StrokeBrush}" Margin="0,20"/>
                    <TextBlock Text="문장 길이와 줄바꿈" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="긴 안내문은 제한된 폭에서 자연스럽게 줄바꿈하고, 중요한 수치와 단위를 가까이 배치합니다." MaxWidth="680" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <TextBlock Text="토큰: FontPageTitle · FontSectionTitle · FontBody · FontCaption" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontCaption}" Margin="0,18,0,0"/>
                    </StackPanel>
                    </Border>
                    </StackPanel>
                    </ScrollViewer>
                    </TabItem>
<TabItem Header="버튼"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8,4"><StackPanel MaxWidth="1040" HorizontalAlignment="Left"><Border x:Name="ControlsSection" Style="{StaticResource SurfaceCard}" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="버튼 계층과 상태" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="호버, 누름, 키보드 포커스, 비활성 상태를 직접 확인하세요." Style="{StaticResource SupportingText}" Margin="0,4,0,14" />
                            <WrapPanel>
                                <ui:OperationButton Content="기본" Variant="Standard" Click="DemoButton_Click" Margin="0,0,8,8" />
                                <ui:OperationButton Content="주요 동작" Variant="Primary" Margin="0,0,8,8" />
                                <ui:OperationButton Content="안전 확인" Variant="Success" Margin="0,0,8,8" />
                                <ui:OperationButton Content="주의 동작" Variant="Warning" Margin="0,0,8,8" />
                                <ui:OperationButton Content="정지" Variant="Danger" Margin="0,0,8,8" />
                                <ui:OperationButton Content="사용할 수 없음" IsEnabled="False" Margin="0,0,8,8" />
                                <ui:OperationButton Content="저장" IsBusy="True" Click="DemoButton_Click" BusyContent="저장 중" Margin="0,0,8,8" />
                            </WrapPanel>
<StackPanel Margin="0,8,0,0"><TextBlock Text="크기 단계" Style="{StaticResource SupportingText}" Margin="0,0,0,6"/><WrapPanel><ui:OperationButton Content="Compact 36" Size="Compact" Margin="0,0,8,8"/><ui:OperationButton Content="Standard 44" Size="Standard" Margin="0,0,8,8"/><ui:OperationButton Content="Large 52" Size="Large" Margin="0,0,8,8"/><ui:OperationButton Content="Apply" AutomationProperties.Name="Apply changes" Margin="0,0,8,8"/><ui:OperationButton x:Name="FocusPreviewButton" Content="Focus" AutomationProperties.Name="Keyboard focus preview" Margin="0,0,8,8"/></WrapPanel></StackPanel>
<TextBlock x:Name="ButtonInteractionStatus" Text="일반 버튼을 눌러 작동을 확인하세요." Style="{StaticResource SupportingText}" Margin="0,2,0,8"/>


                        </StackPanel>
                    </Border></StackPanel></ScrollViewer></TabItem>
<TabItem Header="입력"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8,4"><StackPanel MaxWidth="1040" HorizontalAlignment="Left"><Border Style="{StaticResource SurfaceCard}" Padding="24" Margin="4,8,4,20"><StackPanel><TextBlock Text="입력과 선택" Style="{StaticResource SectionTitle}"/><TextBlock Text="필드 라벨, 도움말, 필수 표시, 오류 안내를 한 구성 요소로 재사용합니다." Style="{StaticResource SupportingText}" Margin="0,5,0,18"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><ui:FormField Label="이름" HelpText="사용자에게 보일 이름을 입력합니다." IsRequired="True" Margin="0,0,0,12"><TextBox Text="예: 기본 입력" Width="290" HorizontalAlignment="Left"/></ui:FormField><ui:FormField Label="옵션 선택" HelpText="목록에서 하나를 선택합니다." Margin="0,0,0,8"><ComboBox x:Name="FocusPreviewCombo" SelectedIndex="0" Width="290" HorizontalAlignment="Left"><ComboBoxItem Content="선택하세요"/><ComboBoxItem Content="옵션 A"/><ComboBoxItem Content="옵션 B"/></ComboBox></ui:FormField><CheckBox Content="이 설정 사용" IsChecked="True" Margin="0,8,0,0"/><CheckBox Content="사용 불가" IsEnabled="False"/><TextBlock Text="선택 방식" Style="{StaticResource SupportingText}" Margin="0,8,0,0"/><RadioButton Content="하나 선택" GroupName="InputPreview" IsChecked="True"/><RadioButton Content="다른 선택" GroupName="InputPreview"/></StackPanel><ui:FormField Grid.Column="1" Label="값" IsRequired="True" IsInvalid="True" ErrorMessage="필수 값을 입력하세요." Margin="12,0,0,0"><TextBox Text="값을 확인하세요" Width="290" HorizontalAlignment="Left"/></ui:FormField></Grid><TextBlock Text="키보드: Tab 이동 / Space 체크 / 방향키 선택 / 포커스 / 비활성 / 오류" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontCaption}" Margin="0,14,0,0"/></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
<TabItem Header="알림"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8,4"><StackPanel MaxWidth="1040" HorizontalAlignment="Left"><Border x:Name="FeedbackSection" Style="{StaticResource SurfaceCard}" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="상태와 알림" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="상태는 색상만으로 구분하지 않고 짧은 설명을 함께 제공합니다." Style="{StaticResource SupportingText}" Margin="0,4,0,12" />
                            <ui:NotificationBanner Title="안내" Message="이 메시지는 사용자의 작업을 막지 않는 정보를 전달합니다." Severity="Information" IsDismissible="False" Margin="0,0,0,8"/><ui:NotificationBanner Title="정상" Message="모든 작업이 정상적으로 실행 중입니다." Severity="Success" IsDismissible="False" Margin="0,0,0,8" />
                            <ui:NotificationBanner Title="확인 필요" Message="일부 작업의 응답이 평소보다 느립니다." Severity="Warning" IsDismissible="False" Margin="0,0,0,8" />
                            <ui:NotificationBanner x:Name="ErrorNotification" Title="오류" Message="연결을 확인하고 다시 시도하세요." Severity="Error" DismissRequested="Notification_DismissRequested" />
                        </StackPanel>
                    </Border></StackPanel></ScrollViewer></TabItem>
<TabItem Header="상태와 지표"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8,4"><StackPanel MaxWidth="1040" HorizontalAlignment="Left"><Border x:Name="OperationsSection" Style="{StaticResource SurfaceCard}" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <StackPanel>
                                    <TextBlock Text="설비 상태와 핵심 지표" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="운전 상태는 색상과 텍스트로, 수치는 단위와 기준을 함께 표시합니다." Style="{StaticResource SupportingText}" Margin="0,4,0,0" />
                                </StackPanel>
                                <wpfui:InfoBar DockPanel.Dock="Right" Title="확인 필요" Message="검사 라인 02 · 입력 프레임이 2초간 수신되지 않았습니다."
                                               Severity="Warning" IsOpen="True" IsClosable="False" Margin="16,0,0,0" />
                            </DockPanel>
                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <ui:MetricTile Label="검사 속도" Value="182" Unit="ppm" Context="목표 180 · 최근 1분" Margin="0,0,8,0" />
                                <ui:MetricTile Grid.Column="1" Label="합격률" Value="99.4" Unit="%" Context="최근 1,000개" Margin="4,0" />
                                <ui:MetricTile Grid.Column="2" Label="평균 추론" Value="3.8" Unit="ms" Context="최근 성공 검사" Margin="4,0" />
                                <ui:MetricTile Grid.Column="3" Label="검사 장치" Value="02" Unit="" Context="라인 02 · 프레임 대기 중" Margin="8,0,0,0" />
                            </Grid>
                            <TextBlock Text="상태 표현 예시" Style="{StaticResource SupportingText}" FontSize="{DynamicResource FontCaption}" Margin="0,14,0,0" />
                            <WrapPanel Margin="0,12,0,0">
                                <ui:StatusBadge Content="연결 끊김" State="Offline" Margin="0,0,8,8" />
                                <ui:StatusBadge Content="준비 완료" State="Ready" Margin="0,0,8,8" />
                                <ui:StatusBadge Content="검사 중" State="Running" Margin="0,0,8,8" />
                                <ui:StatusBadge Content="확인 필요" State="Warning" Margin="0,0,8,8" />
                                <ui:StatusBadge Content="장비 오류" State="Fault" Margin="0,0,8,8" />
                            </WrapPanel>
                        </StackPanel>
                    </Border></StackPanel></ScrollViewer></TabItem>
<TabItem Header="목록과 표"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8,4"><StackPanel MaxWidth="1040" HorizontalAlignment="Left"><Border x:Name="DataSection" Style="{StaticResource SurfaceCard}" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <StackPanel><TextBlock Text="목록과 표" Style="{StaticResource SectionTitle}"/><TextBlock Text="행 동작과 선택 상태를 확인하는 공통 데이터 표시" Style="{StaticResource SupportingText}" Margin="0,4,0,0"/></StackPanel>
                                <Button Content="새 작업" Style="{StaticResource PrimaryButton}" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <ListBox SelectedIndex="1" Height="190" Margin="0,0,14,0">
                                    <ListBoxItem Content="조립 구역 · 설비 01"/><ListBoxItem Content="검수 구역 · 설비 02"/><ListBoxItem Content="포장 구역 · 설비 03"/>
                                </ListBox>
                                <DataGrid x:Name="SampleGrid" Grid.Column="1" Height="190" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="작업" Binding="{Binding Name}" Width="1.2*"/>
                                        <DataGridTextColumn Header="구역" Binding="{Binding Area}" Width="1*"/>
                                        <DataGridTextColumn Header="상태" Binding="{Binding Status}" Width="0.9*"/>
                                        <DataGridTextColumn Header="최근 변경" Binding="{Binding Updated}" Width="0.9*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </StackPanel>
                    </Border></StackPanel></ScrollViewer></TabItem>
<TabItem Header="레이아웃"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8,4"><StackPanel MaxWidth="1040" HorizontalAlignment="Left"><Border x:Name="WorkspaceSection" Style="{StaticResource SurfaceCard}" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="작업 공간 구성" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="탐색, 화면 제목, 본문, 상태 표시줄을 조합한 데스크톱 작업 화면" Style="{StaticResource SupportingText}" Margin="0,4,0,14" />
                            <ui:WorkspaceShell Height="248" NavigationWidth="156" ClipToBounds="True">
                                <ui:WorkspaceShell.NavigationContent>
                                    <StackPanel Margin="10"><TextBlock Text="작업" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontCaption}" Margin="8,6,0,8"/><Button Content="개요" Style="{StaticResource SidebarItem}" MinHeight="34" Padding="8,6" HorizontalContentAlignment="Left"/><Button Content="활동 내역" Style="{StaticResource SidebarItem}" MinHeight="34" Padding="8,6" HorizontalContentAlignment="Left"/><Button Content="설정" Style="{StaticResource SidebarItem}" MinHeight="34" Padding="8,6" HorizontalContentAlignment="Left"/></StackPanel>
                                </ui:WorkspaceShell.NavigationContent>
                                <ui:WorkspaceShell.HeaderContent>
                                    <DockPanel LastChildFill="True"><TextBlock Text="최근 갱신 · 방금" Foreground="{DynamicResource TextSecondaryBrush}" DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="{DynamicResource FontCaption}"/><TextBlock Text="운영 개요" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
                                </ui:WorkspaceShell.HeaderContent>
                                <ui:WorkspaceShell.StatusContent>
                                    <TextBlock Text="연결됨 · 로컬 작업 공간" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontCaption}" VerticalAlignment="Center" />
                                </ui:WorkspaceShell.StatusContent>
                                <Grid Margin="16,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource SurfaceCard}" Padding="12" Margin="0,0,8,0"><StackPanel><TextBlock Text="진행 중" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontCaption}"/><TextBlock Text="12" FontSize="{DynamicResource FontMetricValue}" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border>
