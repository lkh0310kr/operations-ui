        <Style TargetType="DataGridCell"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="BorderBrush" Value="#465258"/><Setter Property="Padding" Value="8,4"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#39454A"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#465258"/><Setter Property="Foreground" Value="{StaticResource Text}"/></Trigger><MultiTrigger><MultiTrigger.Conditions><Condition Property="IsSelected" Value="True"/><Condition Property="IsMouseOver" Value="True"/></MultiTrigger.Conditions><Setter Property="Background" Value="#52616A"/></MultiTrigger></Style.Triggers></Style>
