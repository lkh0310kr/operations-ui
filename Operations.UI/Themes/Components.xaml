<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Operations.UI.Controls">
    <Style x:Key="SurfaceCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style x:Key="Card" TargetType="Border" BasedOn="{StaticResource SurfaceCard}" />

    <Style x:Key="InsetSurface" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="SupportingText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="StatusBadge" TargetType="Border">
        <Setter Property="Background" Value="#1D2E28" />
        <Setter Property="BorderBrush" Value="#315342" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="10,5" />
    </Style>

    <Style TargetType="controls:OperationButton">
        <Setter Property="MinHeight" Value="{DynamicResource ActionHeight}" />
        <Setter Property="Padding" Value="16,9" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:OperationButton">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Variant" Value="Primary">
                            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                        <Trigger Property="Variant" Value="Success">
                            <Setter Property="Background" Value="#20392F" />
                            <Setter Property="BorderBrush" Value="#35634D" />
                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                        </Trigger>
                        <Trigger Property="Variant" Value="Warning">
                            <Setter Property="Background" Value="#3B3326" />
                            <Setter Property="BorderBrush" Value="#715B32" />
                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                        </Trigger>
                        <Trigger Property="Variant" Value="Danger">
                            <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.72" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                            <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.42" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="controls:StatusBadge">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:StatusBadge">
                    <Border x:Name="BadgeSurface" Background="{DynamicResource SurfaceRaisedBrush}"
                            CornerRadius="12" Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="StateDot" Width="7" Height="7" Fill="{DynamicResource TextSecondaryBrush}" />
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="State" Value="{x:Static controls:EquipmentState.Ready}">
                            <Setter TargetName="StateDot" Property="Fill" Value="{DynamicResource SuccessBrush}" />
                        </Trigger>
                        <Trigger Property="State" Value="{x:Static controls:EquipmentState.Running}">
                            <Setter TargetName="StateDot" Property="Fill" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="State" Value="{x:Static controls:EquipmentState.Warning}">
                            <Setter TargetName="StateDot" Property="Fill" Value="{DynamicResource WarningBrush}" />
                        </Trigger>
                        <Trigger Property="State" Value="{x:Static controls:EquipmentState.Fault}">
                            <Setter TargetName="StateDot" Property="Fill" Value="{DynamicResource DangerBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="controls:MetricTile">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:MetricTile">
                    <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="6" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="{TemplateBinding Label}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,7,0,0" VerticalAlignment="Bottom">
                                <TextBlock Text="{TemplateBinding Value}" Foreground="{TemplateBinding Foreground}" FontSize="28" FontWeight="SemiBold" />
                                <TextBlock Text="{TemplateBinding Unit}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="7,0,0,3" VerticalAlignment="Bottom" />
                            </StackPanel>
                            <TextBlock Grid.Row="2" Text="{TemplateBinding Context}" Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="12" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WorkspaceSidebar" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CanvasBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>

    <Style x:Key="ToolbarSurface" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <Style TargetType="controls:WorkspaceShell">
        <Setter Property="Background" Value="{DynamicResource CanvasBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:WorkspaceShell">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="NavigationColumn" Width="{TemplateBinding NavigationWidth}" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="56" />
                            <RowDefinition Height="*" />
                            <RowDefinition x:Name="StatusRow" Height="28" />
                        </Grid.RowDefinitions>
                        <Border x:Name="NavigationHost" Grid.RowSpan="3" Style="{StaticResource WorkspaceSidebar}">
                            <ContentPresenter Content="{TemplateBinding NavigationContent}" />
                        </Border>
                        <Border Grid.Column="1" Grid.Row="0" Style="{StaticResource ToolbarSurface}" Padding="18,0">
                            <ContentPresenter Content="{TemplateBinding HeaderContent}" VerticalAlignment="Center" />
                        </Border>
                        <ContentPresenter Grid.Column="1" Grid.Row="1" ContentSource="Content" />
                        <Border x:Name="StatusHost" Grid.Column="1" Grid.Row="2" Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0" Padding="12,0">
                            <ContentPresenter Content="{TemplateBinding StatusContent}" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ShowNavigation" Value="False">
                            <Setter TargetName="NavigationColumn" Property="Width" Value="0" />
                            <Setter TargetName="NavigationHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="ShowStatusBar" Value="False">
                            <Setter TargetName="StatusRow" Property="Height" Value="0" />
                            <Setter TargetName="StatusHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="controls:DialogHost">
        <Setter Property="Background" Value="{DynamicResource CanvasBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:DialogHost">
                    <Grid Background="{TemplateBinding Background}">
                        <ContentPresenter ContentSource="Content" />
                        <Grid x:Name="DialogOverlay" Visibility="Collapsed" Panel.ZIndex="1000" Background="#A6000000">
                            <Button x:Name="PART_Backdrop" Background="Transparent" BorderThickness="0" Padding="0"
                                    Focusable="False" FocusVisualStyle="{x:Null}">
                                <Button.Template><ControlTemplate TargetType="Button"><Border Background="Transparent" /></ControlTemplate></Button.Template>
                            </Button>
                            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding DialogPadding}"
                                    MaxWidth="{TemplateBinding DialogMaxWidth}" MaxHeight="{TemplateBinding DialogMaxHeight}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" KeyboardNavigation.TabNavigation="Cycle">
                                <ContentPresenter x:Name="PART_DialogContent" Content="{Binding DialogContent, RelativeSource={RelativeSource TemplatedParent}}" />
                            </Border>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsDialogOpen" Value="True"><Setter TargetName="DialogOverlay" Property="Visibility" Value="Visible" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="controls:NotificationBanner">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:NotificationBanner">
                    <Border x:Name="NotificationSurface" Background="{DynamicResource SurfaceRaisedBrush}"
                            BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="4" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="3"/><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
                            <Border x:Name="SeverityAccent" Background="{DynamicResource InfoBrush}" CornerRadius="2" Margin="0,1,0,1" />
                            <StackPanel Grid.Column="1" Margin="12,0,8,0">
                                <TextBlock Text="{Binding Title, RelativeSource={RelativeSource TemplatedParent}}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Message, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                            <Button x:Name="PART_DismissButton" Grid.Column="2" Content="×" MinHeight="28" Padding="2" FontSize="17"
                                    Background="Transparent" BorderBrush="Transparent" HorizontalContentAlignment="Center" VerticalAlignment="Top"
                                    ToolTip="알림 닫기" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Severity" Value="{x:Static controls:NotificationSeverity.Success}">
                            <Setter TargetName="NotificationSurface" Property="Background" Value="#20392F" /><Setter TargetName="NotificationSurface" Property="BorderBrush" Value="#35634D" /><Setter TargetName="SeverityAccent" Property="Background" Value="{DynamicResource SuccessBrush}" />
                        </Trigger>
                        <Trigger Property="Severity" Value="{x:Static controls:NotificationSeverity.Warning}">
                            <Setter TargetName="NotificationSurface" Property="Background" Value="#3B3326" /><Setter TargetName="NotificationSurface" Property="BorderBrush" Value="#715B32" /><Setter TargetName="SeverityAccent" Property="Background" Value="{DynamicResource WarningBrush}" />
                        </Trigger>
                        <Trigger Property="Severity" Value="{x:Static controls:NotificationSeverity.Error}">
                            <Setter TargetName="NotificationSurface" Property="Background" Value="#3C292C" /><Setter TargetName="NotificationSurface" Property="BorderBrush" Value="#784247" /><Setter TargetName="SeverityAccent" Property="Background" Value="{DynamicResource DangerBrush}" />
                        </Trigger>
                        <Trigger Property="IsDismissible" Value="True">
                            <Setter TargetName="PART_DismissButton" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
