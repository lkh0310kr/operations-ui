<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Light semantic palette for high-illumination workspaces. -->
    <Color x:Key="CanvasColor">#F5F7F8</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceRaisedColor">#F0F3F4</Color>
    <Color x:Key="SurfaceHoverColor">#E7ECEE</Color>
    <Color x:Key="ScrollThumbColor">#9BAAB0</Color>
    <Color x:Key="StrokeColor">#CBD3D6</Color>
    <Color x:Key="TextPrimaryColor">#20272B</Color>
    <Color x:Key="TextSecondaryColor">#4D5A60</Color>
    <Color x:Key="TextDisabledColor">#657278</Color>
    <Color x:Key="AccentColor">#1769D2</Color>
    <Color x:Key="AccentForegroundColor">#FFFFFF</Color>
    <Color x:Key="AccentHoverColor">#115CB8</Color>
    <Color x:Key="AccentPressedColor">#0D4F9F</Color>
    <Color x:Key="SuccessColor">#16784D</Color>
    <Color x:Key="WarningColor">#805400</Color>
    <Color x:Key="DangerColor">#B42318</Color>
    <Color x:Key="InfoColor">#1769AA</Color>
    <Color x:Key="FocusColor">#145FCC</Color>
    <Color x:Key="SelectionColor">#DCE9FA</Color>
    <Color x:Key="DialogScrimColor">#A6000000</Color>
    <Color x:Key="ErrorSurfaceColor">#FCE9E7</Color>
    <Color x:Key="ErrorHoverSurfaceColor">#F5D5D1</Color>
    <Color x:Key="WarningSurfaceColor">#FFF3D6</Color>
    <Color x:Key="SuccessSurfaceColor">#E0F2E9</Color>
    <Color x:Key="DangerBorderColor">#B42318</Color>
    <Color x:Key="WarningBorderColor">#805400</Color>
    <Color x:Key="SuccessBorderColor">#16784D</Color>

    <SolidColorBrush x:Key="CanvasBrush" Color="{DynamicResource CanvasColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{DynamicResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{DynamicResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{DynamicResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="{DynamicResource ScrollThumbColor}" />
    <SolidColorBrush x:Key="StrokeBrush" Color="{DynamicResource StrokeColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{DynamicResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{DynamicResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{DynamicResource TextDisabledColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="{DynamicResource AccentForegroundColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{DynamicResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{DynamicResource AccentPressedColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{DynamicResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{DynamicResource DangerColor}" />
    <SolidColorBrush x:Key="InfoBrush" Color="{DynamicResource InfoColor}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{DynamicResource FocusColor}" />
    <SolidColorBrush x:Key="SelectionBrush" Color="{DynamicResource SelectionColor}" />
    <SolidColorBrush x:Key="DialogScrimBrush" Color="{DynamicResource DialogScrimColor}" />
    <SolidColorBrush x:Key="ErrorSurfaceBrush" Color="{DynamicResource ErrorSurfaceColor}" />
    <SolidColorBrush x:Key="ErrorHoverSurfaceBrush" Color="{DynamicResource ErrorHoverSurfaceColor}" />
    <SolidColorBrush x:Key="WarningSurfaceBrush" Color="{DynamicResource WarningSurfaceColor}" />
    <SolidColorBrush x:Key="SuccessSurfaceBrush" Color="{DynamicResource SuccessSurfaceColor}" />
    <SolidColorBrush x:Key="DangerBorderBrush" Color="{DynamicResource DangerBorderColor}" />
    <SolidColorBrush x:Key="WarningBorderBrush" Color="{DynamicResource WarningBorderColor}" />
    <SolidColorBrush x:Key="SuccessBorderBrush" Color="{DynamicResource SuccessBorderColor}" />

    <sys:Double x:Key="Space1">4</sys:Double>
    <sys:Double x:Key="Space2">8</sys:Double>
    <sys:Double x:Key="Space3">12</sys:Double>
    <sys:Double x:Key="Space4">16</sys:Double>
    <sys:Double x:Key="Space5">20</sys:Double>
    <sys:Double x:Key="Space6">24</sys:Double>
    <sys:Double x:Key="Space8">32</sys:Double>
    <sys:Double x:Key="Space12">48</sys:Double>
    <sys:Double x:Key="Space16">64</sys:Double>
    <sys:Double x:Key="RadiusSmall">4</sys:Double>
    <sys:Double x:Key="RadiusMedium">8</sys:Double>
    <sys:Double x:Key="RadiusLarge">12</sys:Double>
    <CornerRadius x:Key="RadiusPill">12</CornerRadius>
    <sys:Double x:Key="ControlHeight">44</sys:Double>
    <sys:Double x:Key="ActionHeight">44</sys:Double>
    <sys:Double x:Key="TouchTargetHeight">44</sys:Double>
    <sys:Double x:Key="ButtonHeightCompact">36</sys:Double>
    <sys:Double x:Key="ButtonHeightStandard">44</sys:Double>
    <sys:Double x:Key="ButtonHeightLarge">52</sys:Double>
    <sys:Double x:Key="FontCaption">12</sys:Double>
    <sys:Double x:Key="FontSupporting">13</sys:Double>
    <sys:Double x:Key="FontBody">14</sys:Double>
    <sys:Double x:Key="FontCardTitle">15</sys:Double>
    <sys:Double x:Key="FontMetricValue">28</sys:Double>
    <sys:Double x:Key="FontActionGlyph">17</sys:Double>
    <sys:Double x:Key="FontSectionTitle">18</sys:Double>
    <sys:Double x:Key="FontPageTitle">26</sys:Double>
    <FontFamily x:Key="FontFamilyBody">Segoe UI</FontFamily>
    <FontFamily x:Key="FontFamilyCode">Consolas</FontFamily>
    <Thickness x:Key="FocusBorderThickness">2</Thickness>
    <Thickness x:Key="ValidationBorderThickness">2</Thickness>
    <CornerRadius x:Key="RadiusControl">4</CornerRadius>
    <CornerRadius x:Key="RadiusSurface">6</CornerRadius>

    <!-- Compatibility aliases for the product app while it adopts semantic token names. -->
    <SolidColorBrush x:Key="Bg" Color="{DynamicResource CanvasColor}" />
    <SolidColorBrush x:Key="Panel" Color="{DynamicResource SurfaceColor}" />
    <SolidColorBrush x:Key="PanelAlt" Color="{DynamicResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="Border" Color="{DynamicResource StrokeColor}" />
    <SolidColorBrush x:Key="Text" Color="{DynamicResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="Muted" Color="{DynamicResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="Accent" Color="{DynamicResource AccentColor}" />
    <SolidColorBrush x:Key="Good" Color="{DynamicResource SuccessColor}" />
    <SolidColorBrush x:Key="Bad" Color="{DynamicResource DangerColor}" />
    <SolidColorBrush x:Key="Review" Color="{DynamicResource WarningColor}" />
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
</ResourceDictionary>
