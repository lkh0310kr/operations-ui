<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Dark-first workbench palette. Light theme can replace these semantic keys. -->
    <Color x:Key="CanvasColor">#171B20</Color>
    <Color x:Key="SurfaceColor">#20262D</Color>
    <Color x:Key="SurfaceRaisedColor">#29313A</Color>
    <Color x:Key="SurfaceHoverColor">#343E49</Color>
    <Color x:Key="StrokeColor">#3A4652</Color>
    <Color x:Key="TextPrimaryColor">#F2F4F7</Color>
    <Color x:Key="TextSecondaryColor">#AAB4C0</Color>
    <Color x:Key="TextDisabledColor">#6F7B88</Color>
    <Color x:Key="AccentColor">#5B8CFF</Color>
    <Color x:Key="AccentHoverColor">#78A1FF</Color>
    <Color x:Key="AccentPressedColor">#3F70E6</Color>
    <Color x:Key="SuccessColor">#54C28A</Color>
    <Color x:Key="WarningColor">#F0B454</Color>
    <Color x:Key="DangerColor">#F07070</Color>
    <Color x:Key="InfoColor">#65B8E8</Color>
    <Color x:Key="FocusColor">#91B0FF</Color>

    <SolidColorBrush x:Key="CanvasBrush" Color="{DynamicResource CanvasColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{DynamicResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{DynamicResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{DynamicResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="StrokeBrush" Color="{DynamicResource StrokeColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{DynamicResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{DynamicResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{DynamicResource TextDisabledColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{DynamicResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{DynamicResource AccentPressedColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{DynamicResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{DynamicResource DangerColor}" />
    <SolidColorBrush x:Key="InfoBrush" Color="{DynamicResource InfoColor}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{DynamicResource FocusColor}" />

    <sys:Double x:Key="Space1">4</sys:Double>
    <sys:Double x:Key="Space2">8</sys:Double>
    <sys:Double x:Key="Space3">12</sys:Double>
    <sys:Double x:Key="Space4">16</sys:Double>
    <sys:Double x:Key="Space5">20</sys:Double>
    <sys:Double x:Key="Space6">24</sys:Double>
    <sys:Double x:Key="Space8">32</sys:Double>

    <!-- Compatibility aliases for the product app while it adopts semantic token names. -->
    <SolidColorBrush x:Key="Bg" Color="{DynamicResource CanvasColor}" />
    <SolidColorBrush x:Key="Panel" Color="{DynamicResource SurfaceColor}" />
    <SolidColorBrush x:Key="PanelAlt" Color="{DynamicResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="Border" Color="{DynamicResource StrokeColor}" />
    <SolidColorBrush x:Key="Text" Color="{DynamicResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="Muted" Color="{DynamicResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="Accent" Color="{DynamicResource AccentColor}" />
    <SolidColorBrush x:Key="Good" Color="{DynamicResource SuccessColor}" />
    <SolidColorBrush x:Key="Bad" Color="{DynamicResource DangerColor}" />
    <SolidColorBrush x:Key="Review" Color="{DynamicResource WarningColor}" />
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
</ResourceDictionary>
