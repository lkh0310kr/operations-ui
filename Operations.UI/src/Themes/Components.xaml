<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:controls="clr-namespace:Operations.UI.Controls">
    <Style x:Key="SurfaceCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSurface}" />
    </Style>
    <Style x:Key="Card" TargetType="Border" BasedOn="{StaticResource SurfaceCard}" />

    <Style x:Key="InsetSurface" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
    </Style>

    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontPageTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSectionTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="CardTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontCardTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontBody}" />
    </Style>
    <Style x:Key="SupportingText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSupporting}" />
    </Style>
    <Style x:Key="CaptionText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource FontCaption}" />
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontCaption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="StatusBadge" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SuccessSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SuccessBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusPill}" />
        <Setter Property="Padding" Value="10,5" />
    </Style>

    <Style TargetType="controls:OperationButton">
        <Setter Property="MinHeight" Value="{DynamicResource ButtonHeightStandard}" />
        <Setter Property="Padding" Value="16,9" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSurface}" />
        <Setter Property="FontSize" Value="{DynamicResource FontBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:OperationButton">
                    <ControlTemplate.Resources>
                        <DataTemplate DataType="{x:Type sys:String}">
                            <TextBlock Text="{Binding}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Variant, RelativeSource={RelativeSource AncestorType={x:Type controls:OperationButton}}}"
                                                         Value="{x:Static controls:OperationButtonVariant.Primary}">
                                                <Setter Property="Foreground" Value="{DynamicResource Ops.Brush.Action.Primary.Foreground}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Variant, RelativeSource={RelativeSource AncestorType={x:Type controls:OperationButton}}}"
                                                         Value="{x:Static controls:OperationButtonVariant.Success}">
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Variant, RelativeSource={RelativeSource AncestorType={x:Type controls:OperationButton}}}"
                                                         Value="{x:Static controls:OperationButtonVariant.Warning}">
                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Variant, RelativeSource={RelativeSource AncestorType={x:Type controls:OperationButton}}}"
                                                         Value="{x:Static controls:OperationButtonVariant.Danger}">
                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType={x:Type controls:OperationButton}}}" Value="False">
                                                <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </ControlTemplate.Resources>
                    <Grid>
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <ContentPresenter x:Name="ButtonLabel" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              RecognizesAccessKey="True" />
                            <StackPanel x:Name="BusyIndicator" Orientation="Horizontal" HorizontalAlignment="Center"
                                        VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False">
                                <Ellipse Width="12" Height="12" Stroke="{TemplateBinding Foreground}"
                                         StrokeThickness="2" StrokeDashArray="2 1" />
                                <ContentPresenter Content="{TemplateBinding BusyContent}" Margin="8,0,0,0"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border x:Name="FocusRing" BorderBrush="{DynamicResource FocusBrush}" BorderThickness="2" CornerRadius="{TemplateBinding CornerRadius}" Visibility="Collapsed" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Variant" Value="Primary">
                            <Setter Property="Background" Value="{DynamicResource Ops.Brush.Action.Primary.Background}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource Ops.Brush.Action.Primary.Background}" />
                            <Setter Property="Foreground" Value="{DynamicResource Ops.Brush.Action.Primary.Foreground}" />
                            <Setter TargetName="ButtonLabel" Property="TextElement.Foreground" Value="{DynamicResource Ops.Brush.Action.Primary.Foreground}" />
                        </Trigger>
                        <Trigger Property="Variant" Value="Success">
                            <Setter Property="Background" Value="{DynamicResource SuccessSurfaceBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource SuccessBorderBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                            <Setter TargetName="ButtonLabel" Property="TextElement.Foreground" Value="{DynamicResource SuccessBrush}" />
                        </Trigger>
                        <Trigger Property="Variant" Value="Warning">
                            <Setter Property="Background" Value="{DynamicResource WarningSurfaceBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource WarningBorderBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                            <Setter TargetName="ButtonLabel" Property="TextElement.Foreground" Value="{DynamicResource WarningBrush}" />
                        </Trigger>
                        <Trigger Property="Variant" Value="Danger">
                            <Setter Property="Background" Value="{DynamicResource ErrorSurfaceBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                            <Setter TargetName="ButtonLabel" Property="TextElement.Foreground" Value="{DynamicResource DangerBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.72" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsBusy" Value="True">
                            <Setter TargetName="ButtonLabel" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="BusyIndicator" Property="Visibility" Value="Visible" />
                            <Setter Property="Cursor" Value="Wait" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceBrush}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Size" Value="Compact">
                <Setter Property="MinHeight" Value="{DynamicResource ButtonHeightCompact}" />
                <Setter Property="Padding" Value="12,5" />
                <Setter Property="FontSize" Value="{DynamicResource FontSupporting}" />
            </Trigger>
            <Trigger Property="Size" Value="Standard">
                <Setter Property="MinHeight" Value="{DynamicResource ButtonHeightStandard}" />
                <Setter Property="Padding" Value="16,9" />
                <Setter Property="FontSize" Value="{DynamicResource FontBody}" />
            </Trigger>
            <Trigger Property="Size" Value="Large">
                <Setter Property="MinHeight" Value="{DynamicResource ButtonHeightLarge}" />
                <Setter Property="Padding" Value="18,11" />
                <Setter Property="FontSize" Value="{DynamicResource FontCardTitle}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="controls:FormField">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource FontBody}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:FormField">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="PART_Label" Text="{TemplateBinding Label}" FontWeight="SemiBold" />
                            <TextBlock x:Name="RequiredIndicator" Text="필수" Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="{DynamicResource FontCaption}" Margin="8,0,0,0" Visibility="Collapsed" />
                        </StackPanel>
                        <ContentPresenter Grid.Row="1" ContentSource="Content" Margin="0,6,0,0" />
                        <TextBlock x:Name="HelpMessage" Grid.Row="2" Text="{TemplateBinding HelpText}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontSupporting}"
                                   TextWrapping="Wrap" Margin="0,5,0,0" Visibility="Visible" />
                        <TextBlock x:Name="ErrorMessage" Grid.Row="3" Text="{TemplateBinding ErrorMessage}"
                                   Foreground="{DynamicResource DangerBrush}" FontSize="{DynamicResource FontSupporting}"
                                   TextWrapping="Wrap" Margin="0,5,0,0" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsRequired" Value="True">
                            <Setter TargetName="RequiredIndicator" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsInvalid" Value="True">
                            <Setter TargetName="ErrorMessage" Property="Visibility" Value="Visible" />
                            <Setter TargetName="HelpMessage" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding HelpText, RelativeSource={RelativeSource TemplatedParent}}" Value="" />
                                <Condition Binding="{Binding IsInvalid, RelativeSource={RelativeSource TemplatedParent}}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="HelpMessage" Property="Visibility" Value="Collapsed" />
                        </MultiDataTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_Label" Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="controls:OperationSwitch">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="MinHeight" Value="{DynamicResource TouchTargetHeight}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:OperationSwitch">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border x:Name="SwitchTrack" Width="40" Height="22" HorizontalAlignment="Left" VerticalAlignment="Center"
                                Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource StrokeBrush}"
                                BorderThickness="1" CornerRadius="{DynamicResource RadiusPill}" />
                        <Ellipse x:Name="SwitchThumb" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center"
                                 Margin="4,0,0,0" Fill="{DynamicResource TextPrimaryBrush}" />
                        <ContentPresenter Grid.Column="1" ContentSource="Content" VerticalAlignment="Center" Margin="8,0,0,0"
                                          RecognizesAccessKey="True" />
                        <Border x:Name="FocusRing" Grid.ColumnSpan="2" BorderBrush="{DynamicResource FocusBrush}"
                                BorderThickness="{DynamicResource FocusBorderThickness}" CornerRadius="{DynamicResource RadiusControl}"
                                Visibility="Collapsed" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="SwitchTrack" Property="Background" Value="{DynamicResource StrokeBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="SwitchTrack" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="SwitchThumb" Property="Margin" Value="0,0,4,0" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
                            <Setter TargetName="SwitchTrack" Property="Opacity" Value="0.55" />
                            <Setter TargetName="SwitchThumb" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="controls:StatusBadge">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource FontCaption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:StatusBadge">
                    <Border x:Name="BadgeSurface" Background="{DynamicResource SurfaceRaisedBrush}"
                            CornerRadius="{DynamicResource RadiusPill}" Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="StateDot" Width="7" Height="7" Fill="{DynamicResource TextSecondaryBrush}" />
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="State" Value="{x:Static controls:EquipmentState.Ready}">
                            <Setter TargetName="StateDot" Property="Fill" Value="{DynamicResource SuccessBrush}" />
                        </Trigger>
                        <Trigger Property="State" Value="{x:Static controls:EquipmentState.Running}">
                            <Setter TargetName="StateDot" Property="Fill" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="State" Value="{x:Static controls:EquipmentState.Warning}">
                            <Setter TargetName="StateDot" Property="Fill" Value="{DynamicResource WarningBrush}" />
                        </Trigger>
                        <Trigger Property="State" Value="{x:Static controls:EquipmentState.Fault}">
                            <Setter TargetName="StateDot" Property="Fill" Value="{DynamicResource DangerBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="controls:MetricTile">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:MetricTile">
                    <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="{DynamicResource RadiusSurface}" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="{TemplateBinding Label}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontCaption}" />
                            <StackPanel x:Name="ValueDisplay" Grid.Row="1" Orientation="Horizontal" Margin="0,7,0,0" VerticalAlignment="Bottom">
                                <TextBlock Text="{TemplateBinding Value}" Foreground="{TemplateBinding Foreground}" FontSize="{DynamicResource FontMetricValue}" FontWeight="SemiBold" />
                                <TextBlock Text="{TemplateBinding Unit}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontSupporting}" Margin="7,0,0,3" VerticalAlignment="Bottom" />
                            </StackPanel>
                            <ProgressBar x:Name="LoadingIndicator" Grid.Row="1" Value="35" IsIndeterminate="True" Height="4" Width="64"
                                         HorizontalAlignment="Left" VerticalAlignment="Center" Background="{DynamicResource SurfaceBrush}"
                                         Foreground="{DynamicResource AccentBrush}" BorderThickness="0" Visibility="Collapsed" />
                            <TextBlock x:Name="ContextText" Grid.Row="2" Text="{TemplateBinding Context}" Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="{DynamicResource FontCaption}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="StateMessageText" Grid.Row="2" Text="{TemplateBinding StateMessage}" Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="{DynamicResource FontSupporting}" Margin="0,5,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="State" Value="{x:Static controls:MetricTileState.Loading}">
                            <Setter TargetName="ValueDisplay" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="LoadingIndicator" Property="Visibility" Value="Visible" />
                            <Setter TargetName="ContextText" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="StateMessageText" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="State" Value="{x:Static controls:MetricTileState.Empty}">
                            <Setter TargetName="ValueDisplay" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ContextText" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="StateMessageText" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="State" Value="{x:Static controls:MetricTileState.Error}">
                            <Setter TargetName="ValueDisplay" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ContextText" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="StateMessageText" Property="Visibility" Value="Visible" />
                            <Setter TargetName="StateMessageText" Property="Foreground" Value="{DynamicResource DangerBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WorkspaceSidebar" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CanvasBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>

    <Style x:Key="ToolbarSurface" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <Style TargetType="controls:DataStatePanel">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:DataStatePanel">
                    <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource StrokeBrush}"
                            BorderThickness="1" CornerRadius="{DynamicResource RadiusSurface}" Padding="20">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
                            <ProgressBar x:Name="LoadingIndicator" IsIndeterminate="True" Height="4" Width="64"
                                         HorizontalAlignment="Center" Background="{DynamicResource SurfaceBrush}"
                                         Foreground="{DynamicResource AccentBrush}" BorderThickness="0" Visibility="Collapsed" />
                            <TextBlock x:Name="StateGlyph" Text="○" FontSize="24" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="{TemplateBinding Title}" FontSize="{DynamicResource FontCardTitle}" FontWeight="SemiBold"
                                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0" />
                            <TextBlock Text="{TemplateBinding Message}" Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0" />
                            <ContentPresenter x:Name="ActionPresenter" Content="{TemplateBinding ActionContent}" HorizontalAlignment="Center" Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="State" Value="{x:Static controls:DataStateKind.Loading}">
                            <Setter TargetName="LoadingIndicator" Property="Visibility" Value="Visible" />
                            <Setter TargetName="StateGlyph" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ActionPresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="State" Value="{x:Static controls:DataStateKind.Error}">
                            <Setter TargetName="StateGlyph" Property="Text" Value="!" />
                            <Setter TargetName="StateGlyph" Property="Foreground" Value="{DynamicResource DangerBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="controls:WorkspaceShell">
        <Setter Property="Background" Value="{DynamicResource CanvasBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:WorkspaceShell">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="NavigationColumn" Width="{TemplateBinding NavigationWidth}" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="56" />
                            <RowDefinition Height="*" />
                            <RowDefinition x:Name="StatusRow" Height="28" />
                        </Grid.RowDefinitions>
                        <Border x:Name="NavigationHost" Grid.RowSpan="3" Style="{StaticResource WorkspaceSidebar}">
                            <ContentPresenter Content="{TemplateBinding NavigationContent}" />
                        </Border>
                        <Border Grid.Column="1" Grid.Row="0" Style="{StaticResource ToolbarSurface}" Padding="18,0">
                            <ContentPresenter Content="{TemplateBinding HeaderContent}" VerticalAlignment="Center" />
                        </Border>
                        <ContentPresenter Grid.Column="1" Grid.Row="1" ContentSource="Content" />
                        <Border x:Name="StatusHost" Grid.Column="1" Grid.Row="2" Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0" Padding="12,0">
                            <ContentPresenter Content="{TemplateBinding StatusContent}" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ShowNavigation" Value="False">
                            <Setter TargetName="NavigationColumn" Property="Width" Value="0" />
                            <Setter TargetName="NavigationHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="ShowStatusBar" Value="False">
                            <Setter TargetName="StatusRow" Property="Height" Value="0" />
                            <Setter TargetName="StatusHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="controls:DialogHost">
        <Setter Property="Background" Value="{DynamicResource CanvasBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:DialogHost">
                    <Grid Background="{TemplateBinding Background}">
                        <ContentPresenter x:Name="BackgroundContent" ContentSource="Content" />
                        <Grid x:Name="DialogOverlay" Visibility="Collapsed" Panel.ZIndex="1000" Background="{DynamicResource DialogScrimBrush}">
                            <Button x:Name="PART_Backdrop" Background="Transparent" BorderThickness="0" Padding="0"
                                    Focusable="False" FocusVisualStyle="{x:Null}">
                                <Button.Template><ControlTemplate TargetType="Button"><Border Background="Transparent" /></ControlTemplate></Button.Template>
                            </Button>
                            <Border x:Name="DialogSurface" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}"
                                    BorderThickness="1" CornerRadius="{DynamicResource Ops.Radius.Dialog}" Padding="{TemplateBinding DialogPadding}"
                                    MaxWidth="{TemplateBinding DialogMaxWidth}" MaxHeight="{TemplateBinding DialogMaxHeight}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" KeyboardNavigation.TabNavigation="Cycle">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                    <ContentPresenter x:Name="PART_DialogContent" Content="{Binding DialogContent, RelativeSource={RelativeSource TemplatedParent}}" />
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsDialogOpen" Value="True"><Setter TargetName="DialogOverlay" Property="Visibility" Value="Visible" /><Setter TargetName="BackgroundContent" Property="IsEnabled" Value="False" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="controls:NotificationBanner">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:NotificationBanner">
                    <Border x:Name="NotificationSurface" Background="{DynamicResource SurfaceRaisedBrush}"
                            BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="{DynamicResource RadiusControl}" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="3"/><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
                            <Border x:Name="SeverityAccent" Background="{DynamicResource InfoBrush}" CornerRadius="2" Margin="0,1,0,1" />
                            <StackPanel Grid.Column="1" Margin="12,0,8,0">
                                <TextBlock Text="{Binding Title, RelativeSource={RelativeSource TemplatedParent}}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Message, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                            <Button x:Name="PART_DismissButton" Grid.Column="2" Content="×" MinHeight="28" Padding="2" FontSize="{DynamicResource FontActionGlyph}"
                                    Background="Transparent" BorderBrush="Transparent" HorizontalContentAlignment="Center" VerticalAlignment="Top"
                                    ToolTip="알림 닫기" AutomationProperties.Name="알림 닫기" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Severity" Value="{x:Static controls:NotificationSeverity.Success}">
                            <Setter TargetName="NotificationSurface" Property="Background" Value="{DynamicResource SuccessSurfaceBrush}" /><Setter TargetName="NotificationSurface" Property="BorderBrush" Value="{DynamicResource SuccessBorderBrush}" /><Setter TargetName="SeverityAccent" Property="Background" Value="{DynamicResource SuccessBrush}" />
                        </Trigger>
                        <Trigger Property="Severity" Value="{x:Static controls:NotificationSeverity.Warning}">
                            <Setter TargetName="NotificationSurface" Property="Background" Value="{DynamicResource WarningSurfaceBrush}" /><Setter TargetName="NotificationSurface" Property="BorderBrush" Value="{DynamicResource WarningBorderBrush}" /><Setter TargetName="SeverityAccent" Property="Background" Value="{DynamicResource WarningBrush}" />
                        </Trigger>
                        <Trigger Property="Severity" Value="{x:Static controls:NotificationSeverity.Error}">
                            <Setter TargetName="NotificationSurface" Property="Background" Value="{DynamicResource ErrorSurfaceBrush}" /><Setter TargetName="NotificationSurface" Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" /><Setter TargetName="SeverityAccent" Property="Background" Value="{DynamicResource DangerBrush}" />
                        </Trigger>
                        <Trigger Property="IsDismissible" Value="True">
                            <Setter TargetName="PART_DismissButton" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
