<Window x:Class="VisionApp.UiCatalog.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vision · UI 카탈로그" Width="1280" Height="900" MinWidth="980" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="Segoe UI" Loaded="Window_Loaded">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="#171E21" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0" Padding="18,24">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,26">
                    <TextBlock Text="Vision UI" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Text="구성 요소와 상태 확인" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel Grid.Row="1">
                    <TextBlock Text="기초 요소" Foreground="{StaticResource Muted}" FontSize="12" Margin="12,0,0,8"/>
                    <Button Content="색과 글자" Tag="ColorsSection" Click="NavigateToSection_Click" Style="{StaticResource SettingsSidebarButton}"/>
                    <Button Content="버튼" Tag="ButtonsSection" Click="NavigateToSection_Click" Style="{StaticResource SettingsSidebarButton}"/>
                    <Button Content="입력" Tag="InputsSection" Click="NavigateToSection_Click" Style="{StaticResource SettingsSidebarButton}"/>
                    <Button Content="상태 표시" Tag="StatesSection" Click="NavigateToSection_Click" Style="{StaticResource SettingsSidebarButton}"/>
                    <Button Content="목록과 표" Tag="TablesSection" Click="NavigateToSection_Click" Style="{StaticResource SettingsSidebarButton}"/>
                    <Button Content="대화상자" Tag="DialogsSection" Click="NavigateToSection_Click" Style="{StaticResource SettingsSidebarButton}"/>
                </StackPanel>
                <TextBlock Grid.Row="2" Text="제품 데이터와 분리된 UI 확인 도구" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="4,20,4,0"/>
            </Grid>
        </Border>
        <ScrollViewer x:Name="CatalogScrollViewer" Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="32,24">
            <StackPanel MaxWidth="960" HorizontalAlignment="Left">
                <TextBlock Text="UI 구성 요소" FontSize="30" FontWeight="Bold"/>
                <TextBlock Text="실제 앱과 공유하는 스타일을 각 상태별로 확인합니다." Foreground="{StaticResource Muted}" FontSize="14" Margin="0,7,0,26"/>

                <Border x:Name="ColorsSection" Style="{StaticResource Card}" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="색과 글자" FontSize="19" FontWeight="SemiBold"/>
                        <UniformGrid Columns="5" Margin="0,16,0,0">
                            <StackPanel Margin="4"><Border Height="56" Background="{StaticResource Bg}" BorderBrush="{StaticResource Border}" BorderThickness="1"/><TextBlock Text="작업 배경" Margin="0,7,0,0"/></StackPanel>
                            <StackPanel Margin="4"><Border Height="56" Background="{StaticResource Panel}"/><TextBlock Text="패널" Margin="0,7,0,0"/></StackPanel>
                            <StackPanel Margin="4"><Border Height="56" Background="{StaticResource Accent}"/><TextBlock Text="주요 동작" Margin="0,7,0,0"/></StackPanel>
                            <StackPanel Margin="4"><Border Height="56" Background="{StaticResource Good}"/><TextBlock Text="정상" Margin="0,7,0,0"/></StackPanel>
                            <StackPanel Margin="4"><Border Height="56" Background="{StaticResource Bad}"/><TextBlock Text="오류" Margin="0,7,0,0"/></StackPanel>
                        </UniformGrid>
                        <TextBlock Text="화면 제목" FontSize="24" FontWeight="Bold" Margin="4,20,0,0"/>
                        <TextBlock Text="일반 안내 문구와 수치 256 × 256 · 1.120" Foreground="{StaticResource Muted}" Margin="4,6,0,0"/>
                    </StackPanel>
                </Border>

                <Border x:Name="ButtonsSection" Style="{StaticResource Card}" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="버튼" FontSize="19" FontWeight="SemiBold"/>
                        <WrapPanel Margin="0,14,0,0">
                            <Button Content="기본 버튼" Margin="0,0,10,10"/>
                            <Button Content="주요 동작" Style="{StaticResource PrimaryButton}" Margin="0,0,10,10"/>
                            <Button Content="중지" Style="{StaticResource StopButton}" Margin="0,0,10,10"/>
                            <Button Content="사용할 수 없음" IsEnabled="False" Margin="0,0,10,10"/>
                        </WrapPanel>
                        <TextBlock Text="마우스를 올리거나 키보드 Tab으로 focus 상태를 확인하세요." Foreground="{StaticResource Muted}" FontSize="12"/>
                    </StackPanel>
                </Border>

                <Border x:Name="InputsSection" Style="{StaticResource Card}" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="입력" FontSize="19" FontWeight="SemiBold"/>
                        <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0"><TextBlock Text="일반 입력" Foreground="{StaticResource Muted}" Margin="0,0,0,7"/><TextBox Text="제품 이름"/></StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0"><TextBlock Text="목록 선택" Foreground="{StaticResource Muted}" Margin="0,0,0,7"/><ComboBox SelectedIndex="0"><ComboBoxItem Content="카메라 1"/><ComboBoxItem Content="카메라 2"/></ComboBox></StackPanel>
                            <StackPanel Grid.Column="2" Margin="12,0,0,0"><TextBlock Text="선택 상태" Foreground="{StaticResource Muted}" Margin="0,0,0,7"/><CheckBox Content="검사 결과 기록" IsChecked="True"/></StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border x:Name="StatesSection" Style="{StaticResource Card}" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="상태 표시" FontSize="19" FontWeight="SemiBold"/>
                        <Border Background="#20382D" BorderBrush="#315C47" BorderThickness="1" Padding="12" Margin="0,14,0,0"><TextBlock Text="모델이 준비되어 있습니다." Foreground="{StaticResource Good}"/></Border>
                        <Border Background="#3A3429" BorderBrush="#8D6934" BorderThickness="1" Padding="12" Margin="0,8,0,0"><TextBlock Text="모델 기준 점수에 가까운 결과입니다. 이미지를 확인하세요." Foreground="{StaticResource Review}" TextWrapping="Wrap"/></Border>
                        <Border Background="#3B2929" BorderBrush="#78413D" BorderThickness="1" Padding="12" Margin="0,8,0,0"><TextBlock Text="카메라를 찾지 못했습니다." Foreground="{StaticResource Bad}"/></Border>
                    </StackPanel>
                </Border>

                <Border x:Name="TablesSection" Style="{StaticResource Card}" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="목록과 표" FontSize="19" FontWeight="SemiBold"/>
                        <ListBox Margin="0,14,0,12" SelectedIndex="0"><ListBoxItem Content="제품 A · 설정 · 열기"/><ListBoxItem Content="제품 B · 설정 · 열기"/></ListBox>
                        <DataGrid x:Name="SampleGrid" Height="190" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Background="{StaticResource Panel}" Foreground="{StaticResource Text}" RowBackground="{StaticResource Panel}" AlternatingRowBackground="{StaticResource PanelAlt}" BorderThickness="0" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                            <DataGrid.Columns><DataGridTextColumn Header="파일" Binding="{Binding FileName}" Width="*"/><DataGridTextColumn Header="라벨" Binding="{Binding Label}" Width="120"/><DataGridTextColumn Header="점수" Binding="{Binding Score}" Width="100"/></DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border x:Name="DialogsSection" Style="{StaticResource Card}" Padding="20" Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock Text="대화상자" FontSize="19" FontWeight="SemiBold"/>
                        <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="제품 추가" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="제품 이름을 입력하면 해당 제품 전용 작업 공간이 만들어집니다." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,14,12"/><TextBox Text="조립 부품"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom"><Button Content="취소" Margin="0,0,8,0"/><Button Content="추가" Style="{StaticResource PrimaryButton}"/></StackPanel></Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
